@model WebsiteBanMyPham.ViewModels.TaoKhieuNaiViewModel
@inject ILocalizationHelper LocHelper
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@{
    ViewData["Title"] = L["Complaint_CreateHeading"];
}

<div class="max-w-2xl mx-auto px-4 sm:px-6 py-8 space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="space-y-1">
        <div class="flex items-center gap-2 text-xs text-muted">
            <a asp-controller="TrangChu" asp-action="Index" class="hover:text-primary transition">@L["Nav_Home"]</a>
            <span>/</span>
            <a asp-controller="KhieuNai" asp-action="Index" class="hover:text-primary transition">@L["Complaint_ListHeading"]</a>
            <span>/</span>
            <span class="text-charcoal font-semibold">@L["Complaint_CreateHeading"]</span>
        </div>
        <h1 class="text-2xl font-serif font-bold text-charcoal">@L["Complaint_CreateHeading"]</h1>
        <p class="text-xs text-muted">@L["Complaint_Notice"]</p>
    </div>

    @if (!Model.DanhSachDonHang.Any())
    {
        <!-- Thông báo giải thích điều kiện khi không có đơn nào đủ điều kiện -->
        <div class="bg-surface p-8 rounded-card border border-borderLight shadow-soft text-center space-y-4 text-xs">
            <div class="w-16 h-16 mx-auto rounded-full bg-[#FDF3E7] text-statusWarning flex items-center justify-center text-2xl">
                <i class="ph ph-warning-circle"></i>
            </div>
            <div class="space-y-2 max-w-md mx-auto">
                <p class="font-bold text-charcoal text-sm">@L["Complaint_NoEligibleOrder_Title"]</p>
                <p class="text-muted leading-relaxed">
                    @string.Format(L["Complaint_NoEligibleOrder_Desc"].Value, WebsiteBanMyPham.Constants.KhieuNaiConstant.SoNgayToiDaSauGiaoHang, LocHelper.GetOrderStatusLabel(WebsiteBanMyPham.Constants.TrangThaiDonHangConstant.HoanThanh))
                </p>
            </div>
            <a asp-controller="DonHang" asp-action="Index"
               class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary hover:bg-primaryHover text-white font-bold rounded-btn transition shadow-sm">
                <i class="ph ph-clipboard-text"></i>
                <span>@L["Order_PageTitle"]</span>
            </a>
        </div>
    }
    else
    {
        <form asp-controller="KhieuNai" asp-action="Tao" method="post" id="complaint-form" class="bg-surface p-6 rounded-card border border-borderLight shadow-soft space-y-5 text-xs">
            <div asp-validation-summary="ModelOnly" class="p-3 rounded-btn bg-[#FCEAEA] text-statusDanger font-medium"></div>

            <!-- Chọn đơn hàng liên quan (Bắt buộc) -->
            <div class="space-y-1.5">
                <label asp-for="MaDH" class="font-bold text-charcoal">
                    @L["Complaint_RelatedOrder"] <span class="text-statusDanger">*</span>
                </label>
                <select asp-for="MaDH" id="complaint-order-select" class="w-full px-3.5 py-2.5 rounded-btn bg-cream/50 border border-borderLight focus:bg-surface focus:border-primary focus:outline-none transition font-medium text-charcoal">
                    @foreach (var d in Model.DanhSachDonHang)
                    {
                        <option value="@d.MaDH" selected="@(d.MaDH == Model.MaDH)">
                            @d.MaDonHangText (@L["Order_DeliveredDate"] @LocHelper.FormatDateTime(d.NgayGiaoThanhCong))
                        </option>
                    }
                </select>
                <span asp-validation-for="MaDH" class="text-statusDanger"></span>
            </div>

            <!-- Chọn sản phẩm liên quan (Tùy chọn) -->
            <div class="space-y-1.5">
                <label asp-for="MaSP" class="font-bold text-charcoal">
                    @L["Complaint_RelatedProduct"]
                </label>
                <select asp-for="MaSP" id="complaint-product-select"
                        data-prompt="@L["Complaint_SelectProductPrompt"]"
                        class="w-full px-3.5 py-2.5 rounded-btn bg-cream/50 border border-borderLight focus:bg-surface focus:border-primary focus:outline-none transition font-medium text-charcoal">
                    <option value="">@L["Complaint_SelectProductPrompt"]</option>
                </select>
                <span asp-validation-for="MaSP" class="text-statusDanger"></span>
            </div>

            <!-- Nội dung khiếu nại (10 - 1000 ký tự) -->
            <div class="space-y-1.5">
                <div class="flex items-center justify-between">
                    <label asp-for="NoiDung" class="font-bold text-charcoal">
                        @L["Complaint_Content"]
                    </label>
                    <span id="complaint-char-count" class="text-muted text-[11px]">0/1000</span>
                </div>
                <textarea asp-for="NoiDung"
                          id="complaint-content-input"
                          rows="5"
                          maxlength="1000"
                          placeholder="@L["Complaint_ContentPlaceholder"]"
                          class="w-full px-3.5 py-2.5 rounded-btn bg-cream/50 border border-borderLight focus:bg-surface focus:border-primary focus:outline-none transition text-charcoal text-xs"></textarea>
                <span asp-validation-for="NoiDung" class="text-statusDanger"></span>
            </div>

            <!-- Nút gửi -->
            <div class="flex items-center justify-end gap-3 pt-3 border-t border-borderLight">
                <a asp-controller="KhieuNai" asp-action="Index"
                   class="px-5 py-2.5 rounded-btn bg-cream hover:bg-pastel text-charcoal font-bold transition">
                    @L["Common_Back"]
                </a>
                <button type="submit"
                        class="px-6 py-2.5 rounded-btn bg-primary hover:bg-primaryHover text-white font-bold transition shadow-sm">
                    @L["Complaint_Submit"]
                </button>
            </div>
        </form>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Dữ liệu đơn hàng và sản phẩm phục vụ lọc động dropdown sản phẩm
        var orderData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DanhSachDonHang.Select(d => new
        {
            maDH = d.MaDH,
            sanPhams = d.SanPhams.Select(s => new { maSP = s.MaSP, tenSP = s.TenSP })
        })));

        var orderSelect = document.getElementById('complaint-order-select');
        var productSelect = document.getElementById('complaint-product-select');
        var selectedMaSP = @(Model.MaSP.HasValue ? Model.MaSP.Value.ToString() : "null");

        function updateProductOptions() {
            if (!orderSelect || !productSelect) return;
            var currentMaDH = parseInt(orderSelect.value, 10);
            var promptText = productSelect.dataset.prompt || '';
            productSelect.innerHTML = '<option value="">' + promptText + '</option>';

            var found = orderData.find(function(o) { return o.maDH === currentMaDH; });
            if (found && found.sanPhams) {
                found.sanPhams.forEach(function(sp) {
                    var opt = document.createElement('option');
                    opt.value = sp.maSP;
                    opt.textContent = sp.tenSP;
                    if (selectedMaSP && sp.maSP === selectedMaSP) {
                        opt.selected = true;
                    }
                    productSelect.appendChild(opt);
                });
            }
        }

        if (orderSelect) {
            orderSelect.addEventListener('change', function() {
                selectedMaSP = null;
                updateProductOptions();
            });
            updateProductOptions();
        }

        var contentInput = document.getElementById('complaint-content-input');
        var charCountSpan = document.getElementById('complaint-char-count');
        if (contentInput && charCountSpan) {
            function updateCharCount() {
                var len = contentInput.value ? contentInput.value.length : 0;
                charCountSpan.textContent = len + '/1000';
            }
            contentInput.addEventListener('input', updateCharCount);
            updateCharCount();
        }
    </script>
}

