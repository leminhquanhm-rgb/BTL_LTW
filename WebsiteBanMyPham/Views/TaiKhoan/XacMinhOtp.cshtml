@model WebsiteBanMyPham.ViewModels.XacMinhOtpViewModel
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnvironment

@{
    ViewData["Title"] = L["Account_VerifyOtpTitle"];
}

<div class="max-w-md mx-auto my-10 sm:my-14 px-4">
    <div class="bg-surface p-6 sm:p-8 rounded-card border border-borderLight shadow-soft space-y-6">
        <!-- Tiêu đề trang -->
        <div class="text-center space-y-2">
            <div class="w-12 h-12 mx-auto rounded-full bg-pastel/70 flex items-center justify-center text-primary text-2xl mb-2">
                <i class="ph ph-shield-check"></i>
            </div>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">@L["Account_VerifyOtpTitle"]</h1>
            <p class="text-xs sm:text-sm text-muted">
                @L["Account_VerifyOtpSubtitle"]
                <span class="font-semibold text-charcoal block mt-0.5">@Model.Email</span>
            </p>
        </div>

        @if (WebHostEnvironment.IsDevelopment())
        {
            <!-- Gợi ý dành riêng cho môi trường Development khi demo / chấm bài -->
            <div class="p-3 rounded-btn bg-pastel/40 border border-nude/70 text-xs text-charcoal flex items-start gap-2.5">
                <i class="ph-fill ph-info text-primary text-base shrink-0 mt-0.5"></i>
                <div class="space-y-0.5">
                    <span class="font-bold text-primary block">@L["Account_OtpDemoNote"]</span>
                    <span class="text-muted leading-relaxed">@L["Account_OtpDemoDesc"]</span>
                </div>
            </div>
        }

        <!-- Báo lỗi tổng quát nếu có -->
        <div asp-validation-summary="ModelOnly" class="empty:hidden p-3 rounded-btn bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs"></div>

        <!-- Biểu mẫu xác minh OTP -->
        <form asp-action="XacMinhOtp" method="post" class="space-y-4">
            <input type="hidden" asp-for="Email" />

            <!-- Nhập mã OTP 6 số -->
            <div>
                <label asp-for="Otp" class="block text-xs font-semibold text-charcoal mb-1.5 text-center"></label>
                <input asp-for="Otp" type="text" maxlength="6" inputmode="numeric" pattern="[0-9]{6}" autocomplete="one-time-code" placeholder="••••••"
                       class="w-full py-3 bg-cream/50 border border-borderLight rounded-btn text-center text-2xl font-mono tracking-[0.5em] text-charcoal placeholder:text-muted/40 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition" />
                <span asp-validation-for="Otp" class="text-statusDanger text-xs mt-1 block font-medium text-center"></span>
            </div>

            <!-- Nút xác minh -->
            <div class="pt-2">
                <button type="submit"
                        class="w-full py-2.5 bg-primary text-white font-bold rounded-btn shadow-sm hover:opacity-95 transition flex items-center justify-center gap-2 text-sm">
                    <i class="ph ph-check-circle text-base"></i>
                    <span>@L["Account_BtnVerifyOtp"]</span>
                </button>
            </div>
        </form>

        <!-- Quay lại nhập email khác -->
        <div class="border-t border-borderLight pt-4 text-center text-xs">
            <a asp-action="QuenMatKhau" class="text-charcoal/80 hover:text-primary font-medium inline-flex items-center gap-1.5 transition">
                <i class="ph ph-arrow-left"></i>
                <span>@L["Account_BackToLogin"]</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
