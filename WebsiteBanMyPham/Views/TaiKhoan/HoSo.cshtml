@model WebsiteBanMyPham.ViewModels.HoSoViewModel
@using WebsiteBanMyPham.Constants

@{
    ViewData["Title"] = L["Account_ProfileTitle"];
}

<div class="max-w-4xl mx-auto my-8 sm:my-12 px-4 space-y-6">
    <!-- Tiêu đề trang -->
    <div>
        <h1 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">@L["Account_ProfileTitle"]</h1>
        <p class="text-xs sm:text-sm text-muted mt-1">@L["Account_ProfileSubtitle"]</p>
    </div>

    <!-- Khung chính 2 cột: Sidebar điều hướng & Form nội dung -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Cột trái: Menu điều hướng tài khoản -->
        <div class="md:col-span-1 space-y-3">
            <div class="bg-surface p-4 sm:p-5 rounded-card border border-borderLight shadow-soft space-y-4">
                <div class="flex items-center gap-3 pb-3 border-b border-borderLight">
                    <div class="w-12 h-12 rounded-full bg-pastel text-primary font-bold text-lg flex items-center justify-center shrink-0">
                        @(string.IsNullOrEmpty(Model.HoTen) ? "U" : Model.HoTen.Substring(0, 1).ToUpper())
                    </div>
                    <div class="overflow-hidden">
                        <p class="font-bold text-sm text-charcoal truncate">@Model.HoTen</p>
                        <span class="inline-block px-2 py-0.5 mt-1 rounded text-[10px] font-bold @(Model.VaiTro == VaiTroConstant.QuanTriVien ? "bg-statusDanger/10 text-statusDanger" : "bg-pastel text-primary")">
                            @(Model.VaiTro == VaiTroConstant.QuanTriVien ? L["Account_Role_QuanTriVien"] : L["Account_Role_KhachHang"])
                        </span>
                    </div>
                </div>

                <nav class="space-y-1 text-xs font-semibold">
                    <a asp-action="HoSo"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-btn bg-cream text-primary transition">
                        <i class="ph ph-user text-base"></i>
                        <span>@L["Account_NavProfile"]</span>
                    </a>
                    <a asp-action="DoiMatKhau"
                       class="flex items-center gap-2.5 px-3 py-2 rounded-btn text-charcoal hover:bg-cream transition">
                        <i class="ph ph-lock-key text-base"></i>
                        <span>@L["Account_NavChangePassword"]</span>
                    </a>
                </nav>

                <div class="pt-2 border-t border-borderLight">
                    <form asp-action="DangXuat" method="post">
                        <button type="submit"
                                class="w-full flex items-center gap-2.5 px-3 py-2 rounded-btn text-statusDanger hover:bg-statusDanger/10 text-xs font-semibold transition">
                            <i class="ph ph-sign-out text-base"></i>
                            <span>@L["Nav_Logout"]</span>
                        </button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Cột phải: Form cập nhật thông tin -->
        <div class="md:col-span-2">
            <div class="bg-surface p-6 sm:p-8 rounded-card border border-borderLight shadow-soft space-y-5">
                <h2 class="text-base font-bold text-charcoal pb-3 border-b border-borderLight">
                    @L["Account_NavProfile"]
                </h2>

                <!-- Báo lỗi tổng quát nếu có -->
                <div asp-validation-summary="ModelOnly" class="empty:hidden p-3 rounded-btn bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs"></div>

                <form asp-action="HoSo" method="post" class="space-y-4">
                    <input type="hidden" asp-for="MaTK" />
                    <input type="hidden" asp-for="VaiTro" />
                    <input type="hidden" asp-for="NgayTao" />

                    <!-- Email (Chỉ đọc) -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="Email" class="block text-xs font-semibold text-charcoal"></label>
                            <span class="text-[11px] text-muted italic">@L["Account_EmailReadonlyNote"]</span>
                        </div>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-base pointer-events-none">
                                <i class="ph ph-envelope-simple"></i>
                            </span>
                            <input asp-for="Email" type="email" readonly
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-cream/70 border border-borderLight rounded-btn text-sm text-charcoal/70 cursor-not-allowed select-none" />
                        </div>
                    </div>

                    <!-- Họ và tên -->
                    <div>
                        <label asp-for="HoTen" class="block text-xs font-semibold text-charcoal mb-1.5"></label>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-base pointer-events-none">
                                <i class="ph ph-user"></i>
                            </span>
                            <input asp-for="HoTen" type="text"
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-surface border border-borderLight rounded-btn text-sm text-charcoal placeholder:text-muted/60 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition" />
                        </div>
                        <span asp-validation-for="HoTen" class="text-statusDanger text-xs mt-1 block font-medium"></span>
                    </div>

                    <!-- Số điện thoại -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="SoDienThoai" class="block text-xs font-semibold text-charcoal"></label>
                            <span class="text-[11px] text-muted italic">@L["Account_Optional"]</span>
                        </div>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-base pointer-events-none">
                                <i class="ph ph-phone"></i>
                            </span>
                            <input asp-for="SoDienThoai" type="tel" placeholder="0901234567"
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-surface border border-borderLight rounded-btn text-sm text-charcoal placeholder:text-muted/60 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition" />
                        </div>
                        <span asp-validation-for="SoDienThoai" class="text-statusDanger text-xs mt-1 block font-medium"></span>
                    </div>

                    <!-- Địa chỉ giao hàng -->
                    <div>
                        <div class="flex items-center justify-between mb-1.5">
                            <label asp-for="DiaChi" class="block text-xs font-semibold text-charcoal"></label>
                            <span class="text-[11px] text-muted italic">@L["Account_Optional"]</span>
                        </div>
                        <div class="relative">
                            <span class="absolute left-3.5 top-1/2 -translate-y-1/2 text-muted text-base pointer-events-none">
                                <i class="ph ph-map-pin"></i>
                            </span>
                            <input asp-for="DiaChi" type="text" placeholder="@L["Placeholder_Address"]"
                                   class="w-full pl-10 pr-3.5 py-2.5 bg-surface border border-borderLight rounded-btn text-sm text-charcoal placeholder:text-muted/60 focus:border-primary focus:ring-1 focus:ring-primary focus:outline-none transition" />
                        </div>
                        <span asp-validation-for="DiaChi" class="text-statusDanger text-xs mt-1 block font-medium"></span>
                    </div>

                    <!-- Nút lưu thông tin -->
                    <div class="pt-2">
                        <button type="submit"
                                class="w-full sm:w-auto px-6 py-2.5 bg-primary text-white font-bold rounded-btn shadow-sm hover:opacity-95 transition flex items-center justify-center gap-2 text-sm">
                            <i class="ph ph-floppy-disk text-base"></i>
                            <span>@L["Account_BtnSaveProfile"]</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
