@{
    ViewData["Title"] = L["Account_AccessDeniedTitle"];
}

<div class="max-w-lg mx-auto my-12 sm:my-16 px-4">
    <div class="bg-surface p-8 sm:p-10 rounded-card border border-borderLight shadow-soft text-center space-y-6">
        <!-- Biểu tượng cảnh báo -->
        <div class="w-16 h-16 mx-auto rounded-full bg-statusDanger/10 text-statusDanger flex items-center justify-center text-3xl">
            <i class="ph ph-shield-warning"></i>
        </div>

        <!-- Tiêu đề & Nội dung -->
        <div class="space-y-2">
            <span class="text-xs uppercase tracking-wider font-bold text-statusDanger">HTTP 403 Forbidden</span>
            <h1 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal">@L["Account_AccessDeniedTitle"]</h1>
            <p class="text-xs sm:text-sm text-muted leading-relaxed max-w-sm mx-auto">
                @L["Account_AccessDeniedDesc"]
            </p>
        </div>

        <!-- Nút điều hướng -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 pt-2">
            <a asp-controller="TrangChu" asp-action="Index"
               class="w-full sm:w-auto px-5 py-2.5 bg-primary text-white font-bold rounded-btn shadow-sm hover:opacity-95 transition flex items-center justify-center gap-2 text-xs sm:text-sm">
                <i class="ph ph-house text-base"></i>
                <span>@L["Account_BtnBackHome"]</span>
            </a>
            <a asp-controller="TaiKhoan" asp-action="DangNhap"
               class="w-full sm:w-auto px-5 py-2.5 bg-cream hover:bg-nude/40 text-charcoal font-semibold border border-borderLight rounded-btn transition flex items-center justify-center gap-2 text-xs sm:text-sm">
                <i class="ph ph-sign-in text-base"></i>
                <span>@L["Account_BtnLoginOther"]</span>
            </a>
        </div>
    </div>
</div>

