@model WebsiteBanMyPham.ViewModels.DatHangViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject WebsiteBanMyPham.Helpers.ILocalizationHelper LocHelper
@{
    ViewData["Title"] = L["Checkout_PageTitle"];
    var hasInvalidItems = !Model.HopLeDeDatHang;
}

<div class="max-w-7xl mx-auto px-4 sm:px-6 py-6 sm:py-8 space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="space-y-1">
        <nav class="flex items-center gap-2 text-xs text-muted" aria-label="Breadcrumb">
            <a asp-controller="TrangChu" asp-action="Index" class="hover:text-primary transition">@L["Nav_Home"]</a>
            <span>/</span>
            <a asp-controller="GioHang" asp-action="Index" class="hover:text-primary transition">@L["Nav_Cart"]</a>
            <span>/</span>
            <span class="text-charcoal font-semibold">@L["Checkout_Breadcrumb"]</span>
        </nav>
        <h1 class="text-xl sm:text-2xl font-serif font-bold text-charcoal">@L["Checkout_PageTitle"]</h1>
    </div>

    <!-- Thông báo lỗi tổng hợp từ ModelState (Điều chỉnh 2) -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="p-4 rounded-card bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs space-y-1" role="alert">
            <div class="flex items-center gap-2 font-bold">
                <i class="ph-fill ph-warning-circle text-base"></i>
                <span>@L["Common_Error"]</span>
            </div>
            <div asp-validation-summary="All" class="pl-6 list-disc [&>ul]:list-disc"></div>
        </div>
    }

    <!-- Form Đặt hàng -->
    <form asp-controller="DatHang" asp-action="XacNhan" method="post" id="checkout-form" class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        @Html.AntiForgeryToken()

        <!-- Các trường ẩn xác thực nguồn đặt hàng và token chống đặt trùng (Điều chỉnh 1) -->
        <input type="hidden" name="NguonDat" id="checkout-nguondat" value="@Model.NguonDat" />
        <input type="hidden" name="MaChongDatTrung" value="@Model.MaChongDatTrung" />
        <input type="hidden" name="CodeKM" id="checkout-applied-code" value="@Model.CodeKM" />

        @if (Model.NguonDat == WebsiteBanMyPham.Constants.NguonDatHangConstant.TuGio)
        {
            @foreach (var maGH in Model.DanhSachMaGH)
            {
                <input type="hidden" name="DanhSachMaGH" class="checkout-magh-hidden" value="@maGH" />
            }
        }
        else
        {
            <input type="hidden" name="MaSPMuaNgay" id="checkout-masp" value="@Model.MaSPMuaNgay" />
            <input type="hidden" name="SoLuongMuaNgay" id="checkout-soluong" value="@Model.SoLuongMuaNgay" />
        }

        <!-- CỘT TRÁI (7 cột): Thông tin nhận hàng & Phương thức thanh toán -->
        <div class="lg:col-span-7 space-y-6">
            <!-- 1. Thông tin người nhận -->
            <div class="bg-surface p-5 sm:p-6 rounded-card border border-borderLight shadow-soft space-y-4">
                <div class="flex items-center justify-between border-b border-borderLight pb-3">
                    <h3 class="text-sm sm:text-base font-bold text-charcoal flex items-center gap-2">
                        <i class="ph-fill ph-map-pin text-primary text-lg"></i>
                        <span>@L["Checkout_RecipientTitle"]</span>
                    </h3>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-charcoal mb-1">
                            @L["Label_TenNguoiNhan"] <span class="text-statusDanger">*</span>
                        </label>
                        <input type="text" name="TenNguoiNhan" value="@Model.TenNguoiNhan" required maxlength="100"
                               placeholder="@L["Label_TenNguoiNhan"]"
                               class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary transition" />
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-charcoal mb-1">
                            @L["Label_SDTNguoiNhan"] <span class="text-statusDanger">*</span>
                        </label>
                        <input type="tel" name="SdtNguoiNhan" value="@Model.SdtNguoiNhan" required maxlength="15"
                               placeholder="0912345678"
                               class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary transition" />
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-charcoal mb-1">
                        @L["Label_DiaChiGiao"] <span class="text-statusDanger">*</span>
                    </label>
                    <input type="text" name="DiaChiGiao" value="@Model.DiaChiGiao" required maxlength="255"
                           placeholder="Số nhà, ngõ, đường, phường/xã, quận/huyện, tỉnh/thành..."
                           class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary transition" />
                </div>

                <div>
                    <label class="block text-xs font-bold text-charcoal mb-1">
                        @L["Label_GhiChu"]
                    </label>
                    <input type="text" name="GhiChu" value="@Model.GhiChu" maxlength="500"
                           placeholder="Ghi chú giao giờ hành chính, gọi điện trước khi giao..."
                           class="w-full px-3.5 py-2 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary transition" />
                </div>
            </div>

            <!-- 2. Phương thức thanh toán (Điều chỉnh 3 & 6: Không còn COD badge; Online badge chỉ hiện khi ChoPhepMoPhong = true) -->
            <div class="bg-surface p-5 sm:p-6 rounded-card border border-borderLight shadow-soft space-y-4">
                <div class="flex items-center justify-between border-b border-borderLight pb-3">
                    <h3 class="text-sm sm:text-base font-bold text-charcoal flex items-center gap-2">
                        <i class="ph-fill ph-credit-card text-primary text-lg"></i>
                        <span>@L["Checkout_PaymentTitle"]</span>
                    </h3>
                </div>

                <div class="space-y-3">
                    @foreach (var pt in Model.DanhSachPhuongThuc)
                    {
                        var isChecked = pt.MaPT == Model.MaPTChon;
                        <label class="flex items-center justify-between p-4 rounded-btn border border-borderLight hover:border-primary cursor-pointer transition select-none @(isChecked ? "border-primary bg-pastel/30" : "")">
                            <div class="flex items-center gap-3">
                                <input type="radio" name="MaPT" value="@pt.MaPT" @(isChecked ? "checked" : "")
                                       class="accent-primary w-4 h-4 cursor-pointer" />
                                <div>
                                    <p class="font-bold text-charcoal text-xs sm:text-sm">@LocHelper.GetPaymentMethodLabel(pt.TenPT)</p>
                                    <p class="text-[11px] text-muted">@L[$"Payment_Method_{pt.TenPT}_Desc"]</p>
                                </div>
                            </div>
                        </label>
                    }
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI (5 cột): Sản phẩm đặt mua, Voucher kép & Xác nhận đơn -->
        <div id="checkout-summary-card" class="lg:col-span-5 bg-surface p-5 sm:p-6 rounded-card border border-borderLight shadow-soft space-y-5"
             data-validation-required="@L["Validation_Required"]"
             data-promo-not-found="@L["Msg_Promo_NotFound"]"
             data-common-select="@L["Common_Select"]"
             data-min-order="@L["Cart_MinOrder"]"
             data-uses-remaining="@L["Cart_UsesRemaining"]">

            <div class="flex items-center justify-between border-b border-borderLight pb-3">
                <h3 class="text-sm sm:text-base font-bold text-charcoal">@L["Checkout_OrderSummaryTitle"]</h3>
                @if (Model.NguonDat == WebsiteBanMyPham.Constants.NguonDatHangConstant.MuaNgay)
                {
                    <span class="px-2.5 py-0.5 rounded-full bg-pastel text-primary text-[11px] font-bold">@L["Checkout_ModeBuyNow"]</span>
                }
                else
                {
                    <span class="px-2.5 py-0.5 rounded-full bg-pastel text-primary text-[11px] font-bold">@L["Checkout_ModeCart"]</span>
                }
            </div>

            <!-- Banner cảnh báo chế độ Mua ngay trực tiếp -->
            @if (Model.NguonDat == WebsiteBanMyPham.Constants.NguonDatHangConstant.MuaNgay)
            {
                <div class="p-3.5 rounded-card bg-pastel/55 border-2 border-primary space-y-2">
                    <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-bold text-primary flex items-center gap-1">
                            <i class="ph-fill ph-lightning text-sm"></i> @L["Checkout_ModeBuyNow"]
                        </span>
                        <a asp-controller="GioHang" asp-action="Index" class="px-2 py-1 rounded bg-surface border border-borderLight text-[11px] font-bold text-charcoal hover:border-primary transition">
                            @L["Checkout_BackToCart"]
                        </a>
                    </div>
                    <p class="text-[11px] text-charcoal leading-snug">
                        @L["Checkout_BuyNowBanner"]
                    </p>
                </div>
            }

            <!-- Danh sách sản phẩm thanh toán (Server tính toán & kiểm tra tồn kho) -->
            <div class="space-y-2.5 max-h-56 overflow-y-auto pr-1 divide-y divide-borderLight border border-borderLight rounded-btn p-3 bg-cream/40">
                @foreach (var item in Model.Items)
                {
                    <div class="pt-2.5 first:pt-0 flex items-center justify-between gap-3 text-xs">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <img src="@(string.IsNullOrEmpty(item.DuongDanAnh) ? "/images/placeholder.svg" : item.DuongDanAnh)"
                                 alt="@item.TenSP"
                                 onerror="this.src='/images/placeholder.svg'"
                                 class="w-12 h-12 rounded object-cover border border-borderLight shrink-0" />
                            <div class="space-y-0.5 min-w-0">
                                <p class="font-bold text-charcoal line-clamp-1">@item.TenSP</p>
                                <p class="text-[11px] text-muted">
                                    <span>@LocHelper.FormatCurrency(item.GiaHienTai)</span>
                                    <span>× @item.SoLuong</span>
                                </p>
                                @if (!item.HopLeDeDat && !string.IsNullOrEmpty(item.ThongBaoTrangThai))
                                {
                                    <span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold bg-statusDanger/10 text-statusDanger">
                                        @item.ThongBaoTrangThai
                                    </span>
                                }
                            </div>
                        </div>
                        <span class="font-bold text-charcoal shrink-0">@LocHelper.FormatCurrency(item.ThanhTien)</span>
                    </div>
                }
            </div>

            <!-- Hệ thống Voucher kép tại trang Đặt hàng (AJAX qua Web API mở rộng theo Điều chỉnh 5) -->
            <div class="p-4 rounded-card bg-cream border border-nude/70 space-y-3">
                <div class="flex items-center justify-between">
                    <label class="text-xs font-bold text-charcoal flex items-center gap-1.5">
                        <i class="ph-fill ph-ticket text-primary text-base"></i>
                        <span>@L["Cart_PromoSectionTitle"]</span>
                    </label>
                    <button type="button" id="btn-remove-promo-checkout" onclick="onRemovePromoCheckout()"
                            class="text-[11px] font-semibold text-statusDanger hover:underline @(string.IsNullOrEmpty(Model.CodeKM) ? "hidden" : "")">
                        @L["Cart_RemovePromo"]
                    </button>
                </div>

                <div class="flex gap-2">
                    <input type="text" id="checkout-promo-input" value="@Model.CodeKM"
                           placeholder="@L["Cart_PromoPlaceholder"]"
                           class="flex-1 px-3 py-2 bg-surface border border-borderLight rounded-btn text-xs uppercase font-mono font-bold text-charcoal focus:outline-none focus:border-primary" />
                    <button type="button" id="btn-apply-promo-checkout" onclick="onApplyPromoCheckout()"
                            class="px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shrink-0">
                        @L["Cart_ApplyPromo"]
                    </button>
                </div>

                <p id="checkout-promo-feedback" class="text-[11px] font-semibold @(!string.IsNullOrEmpty(Model.CodeKM) ? "text-statusSuccess" : "hidden")">
                    @if (!string.IsNullOrEmpty(Model.CodeKM) && Model.TienGiam > 0)
                    {
                        <span>@string.Format(L["Msg_Promo_ApplySuccess"].Value, LocHelper.FormatCurrency(Model.TienGiam))</span>
                    }
                </p>

                <!-- Thẻ voucher có sẵn để bấm chọn trực tiếp -->
                <div class="space-y-2 pt-2 border-t border-borderLight">
                    <p class="text-[10px] font-bold text-muted uppercase">@L["Cart_AvailablePromosTitle"]</p>
                    <div id="checkout-voucher-cards" class="space-y-2 max-h-40 overflow-y-auto pr-1">
                        <!-- Nạp qua AJAX loadAvailablePromosCheckout -->
                    </div>
                </div>
            </div>

            <!-- Bảng tính tiền chi tiết -->
            <div class="space-y-2 text-xs border-b border-borderLight pb-3">
                <div class="flex justify-between text-muted">
                    <span>@L["Checkout_Subtotal"]</span>
                    <span id="checkout-subtotal" class="font-bold text-charcoal">@LocHelper.FormatCurrency(Model.TongTienHang)</span>
                </div>
                <div class="flex justify-between text-muted">
                    <span>@L["Checkout_Discount"]</span>
                    <span id="checkout-discount" class="font-bold text-statusSuccess">-@LocHelper.FormatCurrency(Model.TienGiam)</span>
                </div>
            </div>

            <div class="flex justify-between items-center text-sm font-bold text-charcoal">
                <span>@L["Checkout_Total"]</span>
                <span id="checkout-total" class="text-xl text-primary font-bold">@LocHelper.FormatCurrency(Model.TongThanhToan)</span>
            </div>

            <!-- Nút Xác nhận đặt hàng (Vô hiệu hóa khi có dòng sản phẩm không hợp lệ) -->
            <div class="space-y-2 pt-1">
                <button type="submit" id="btn-submit-order"
                        @(Model.HopLeDeDatHang ? "" : "disabled")
                        class="w-full py-3.5 bg-primary hover:bg-primaryHover text-white text-sm font-bold rounded-btn transition shadow-soft flex items-center justify-center gap-2 @(!Model.HopLeDeDatHang ? "opacity-50 cursor-not-allowed pointer-events-none" : "")">
                    <i class="ph-fill ph-check-circle text-lg"></i>
                    <span>@L["Checkout_ConfirmOrder"]</span>
                </button>

                @if (!Model.HopLeDeDatHang)
                {
                    <p class="text-xs text-center text-statusDanger font-semibold">
                        @L["Checkout_StockWarning"]
                    </p>
                }
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        var currentSubtotal = @Model.TongTienHang;

        function formatCurrencyClient(val) {
            var num = Math.round(val || 0);
            return num.toLocaleString("vi-VN") + "đ";
        }

        async function onApplyPromoCheckout() {
            var input = document.getElementById("checkout-promo-input");
            var card = document.getElementById("checkout-summary-card");
            if (!input || !card) return;

            var code = input.value.trim();
            if (!code) {
                setCheckoutPromoFeedback(card.dataset.validationRequired || "Trường này là bắt buộc.", false);
                return;
            }

            var applyBtn = document.getElementById("btn-apply-promo-checkout");
            if (applyBtn) applyBtn.disabled = true;

            var nguonDat = document.getElementById("checkout-nguondat")?.value;
            var body = { code: code };

            if (nguonDat === "TuGio") {
                var maghEls = document.querySelectorAll(".checkout-magh-hidden");
                var ids = Array.from(maghEls).map(function (el) { return parseInt(el.value, 10); });
                body.maGHDaChon = ids;
            } else {
                body.maSP = parseInt(document.getElementById("checkout-masp")?.value, 10);
                body.soLuong = parseInt(document.getElementById("checkout-soluong")?.value, 10);
            }

            var res = await apiFetch("/api/v1/khuyen-mai/kiem-tra", {
                method: "POST",
                body: body
            });

            if (applyBtn) applyBtn.disabled = false;

            var discountEl = document.getElementById("checkout-discount");
            var totalEl = document.getElementById("checkout-total");
            var hiddenCode = document.getElementById("checkout-applied-code");
            var removeBtn = document.getElementById("btn-remove-promo-checkout");

            if (res && res.ok && res.data) {
                var data = res.data;
                if (data.hopLe) {
                    if (hiddenCode) hiddenCode.value = data.code || code;
                    if (discountEl) discountEl.innerText = "-" + formatCurrencyClient(data.tienGiam);
                    if (totalEl) totalEl.innerText = formatCurrencyClient(data.tongThanhToan);
                    setCheckoutPromoFeedback(data.thongBao, true);
                    if (removeBtn) removeBtn.classList.remove("hidden");
                } else {
                    if (hiddenCode) hiddenCode.value = "";
                    if (discountEl) discountEl.innerText = formatCurrencyClient(0);
                    if (totalEl) totalEl.innerText = formatCurrencyClient(data.tongTienHang || currentSubtotal);
                    setCheckoutPromoFeedback(data.thongBao, false);
                    if (removeBtn) removeBtn.classList.add("hidden");
                }
            }
        }

        function onSelectVoucherCheckout(btn) {
            var code = btn?.dataset?.code || "";
            var input = document.getElementById("checkout-promo-input");
            if (input && code) {
                input.value = code;
                onApplyPromoCheckout();
            }
        }

        function onRemovePromoCheckout() {
            var input = document.getElementById("checkout-promo-input");
            var hiddenCode = document.getElementById("checkout-applied-code");
            var discountEl = document.getElementById("checkout-discount");
            var totalEl = document.getElementById("checkout-total");
            var removeBtn = document.getElementById("btn-remove-promo-checkout");

            if (input) input.value = "";
            if (hiddenCode) hiddenCode.value = "";
            if (discountEl) discountEl.innerText = formatCurrencyClient(0);
            if (totalEl) totalEl.innerText = formatCurrencyClient(currentSubtotal);
            if (removeBtn) removeBtn.classList.add("hidden");
            setCheckoutPromoFeedback("", false);
        }

        function setCheckoutPromoFeedback(msg, isSuccess) {
            var fb = document.getElementById("checkout-promo-feedback");
            if (!fb) return;
            if (!msg) {
                fb.classList.add("hidden");
                fb.innerText = "";
                return;
            }
            fb.innerText = msg;
            fb.className = "text-[11px] font-semibold block " + (isSuccess ? "text-statusSuccess" : "text-statusDanger");
        }

        async function loadAvailablePromosCheckout() {
            var nguonDat = document.getElementById("checkout-nguondat")?.value;
            var url = "";
            if (nguonDat === "TuGio") {
                var maghEls = document.querySelectorAll(".checkout-magh-hidden");
                var ids = Array.from(maghEls).map(function (el) { return parseInt(el.value, 10); });
                if (ids.length === 0) return;
                url = "/api/v1/khuyen-mai/kha-dung?" + ids.map(function (id) { return "maGH=" + id; }).join("&");
            } else {
                url = "/api/v1/khuyen-mai"; // Lấy mã công khai cho Mua ngay
            }

            var res = await apiFetch(url, { method: "GET" });
            if (res && res.ok && Array.isArray(res.data)) {
                renderCheckoutVouchers(res.data);
            }
        }

        function renderCheckoutVouchers(promos) {
            var container = document.getElementById("checkout-voucher-cards");
            var card = document.getElementById("checkout-summary-card");
            if (!container || !card) return;

            var notFound = card.dataset.promoNotFound || "Không tìm thấy mã khuyến mãi khả dụng.";
            var selectText = card.dataset.commonSelect || "Chọn";
            var minOrderLabel = card.dataset.minOrder || "Đơn tối thiểu:";
            var usesRemainingTemplate = card.dataset.usesRemaining || "Còn {0} lượt";

            if (!promos || promos.length === 0) {
                container.innerHTML = '<p class="text-xs text-muted italic py-1">' + notFound + '</p>';
                return;
            }

            var html = promos.map(function (p) {
                var remain = (typeof p.soLuotConLai !== "undefined" && p.soLuotConLai !== null)
                    ? (" • " + usesRemainingTemplate.replace("{0}", p.soLuotConLai))
                    : "";
                return `
                    <div class="p-2.5 rounded-btn bg-surface border border-borderLight hover:border-primary transition cursor-pointer flex items-center justify-between gap-2"
                         data-code="${p.code}"
                         onclick="onSelectVoucherCheckout(this)">
                        <div class="space-y-0.5">
                            <div class="flex items-center gap-1.5">
                                <span class="px-1.5 py-0.5 rounded bg-pastel text-primary text-[10px] font-bold font-mono">${p.code}</span>
                                <span class="text-xs font-bold text-charcoal">${p.tenKM}</span>
                            </div>
                            <p class="text-[10px] text-muted">${minOrderLabel} ${formatCurrencyClient(p.donToiThieu)}${remain}</p>
                        </div>
                        <button type="button" class="px-2.5 py-1 rounded bg-cream hover:bg-pastel text-[11px] font-bold text-primary transition shrink-0">
                            ${selectText}
                        </button>
                    </div>
                `;
            }).join("");
            container.innerHTML = html;
        }

        document.addEventListener("DOMContentLoaded", function () {
            loadAvailablePromosCheckout();
        });
    </script>
}

