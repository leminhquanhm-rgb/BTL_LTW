@model WebsiteBanMyPham.ViewModels.DonHangKhachChiTietViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject WebsiteBanMyPham.Helpers.ILocalizationHelper LocHelper
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = L["OrderSuccess_PageTitle"];
    bool choPhepMoPhong = Configuration.GetValue<bool>("ThanhToan:ChoPhepMoPhong");
    bool canPayNow = choPhepMoPhong &&
                     Model.ThanhToan?.TenPT == WebsiteBanMyPham.Constants.PhuongThucThanhToanConstant.Online &&
                     (Model.ThanhToan?.TrangThai == WebsiteBanMyPham.Constants.TrangThaiThanhToanConstant.ChuaThanhToan ||
                      Model.ThanhToan?.TrangThai == WebsiteBanMyPham.Constants.TrangThaiThanhToanConstant.ThatBai) &&
                     Model.TrangThai != WebsiteBanMyPham.Constants.TrangThaiDonHangConstant.DaHuy;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <!-- Khung thông báo thành công đầu trang -->
    <div class="text-center space-y-3">
        <div class="w-16 h-16 rounded-full bg-statusSuccess/15 text-statusSuccess mx-auto flex items-center justify-center text-3xl shadow-soft">
            <i class="ph-bold ph-check-circle"></i>
        </div>
        <h1 class="text-2xl sm:text-3xl font-serif font-bold text-charcoal">@L["OrderSuccess_Heading"]</h1>
        <!-- Điều chỉnh 6: OrderSuccess_Subtitle dùng tham số {0} từ khóa Brand_Name -->
        <p class="text-xs sm:text-sm text-muted max-w-md mx-auto leading-relaxed">
            @string.Format(L["OrderSuccess_Subtitle"].Value, L["Brand_Name"].Value)
        </p>
    </div>

    <!-- Thẻ chi tiết đơn hàng -->
    <div class="bg-surface rounded-card border border-borderLight shadow-soft overflow-hidden divide-y divide-borderLight">
        <!-- Thông tin chung: Mã đơn, Ngày đặt, Trạng thái đơn -->
        <div class="p-5 sm:p-6 bg-cream/50 flex flex-wrap items-center justify-between gap-4">
            <div>
                <!-- Điều chỉnh 6: Dùng hàm helper MaDonHang ở mọi nơi hiển thị mã đơn -->
                <p class="text-xs text-muted">@L["OrderSuccess_OrderCode"]</p>
                <p class="text-lg font-bold font-mono text-primary">@LocHelper.MaDonHang(Model.MaDH)</p>
            </div>
            <div>
                <p class="text-xs text-muted">@L["OrderSuccess_OrderDate"]</p>
                <p class="text-xs sm:text-sm font-bold text-charcoal">@LocHelper.FormatDateTime(Model.NgayDat)</p>
            </div>
            <div>
                <p class="text-xs text-muted">@L["Label_TrangThai"]</p>
                <span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-pastel text-primary">
                    @LocHelper.GetOrderStatusLabel(Model.TrangThai)
                </span>
            </div>
        </div>

        <!-- Thông tin giao hàng & Phương thức thanh toán -->
        <div class="p-5 sm:p-6 grid grid-cols-1 md:grid-cols-2 gap-6 text-xs">
            <!-- Cột người nhận -->
            <div class="space-y-2">
                <h4 class="font-bold text-charcoal uppercase tracking-wider text-[11px] border-b border-borderLight pb-1.5 flex items-center gap-1.5">
                    <i class="ph-fill ph-map-pin text-primary"></i>
                    <span>@L["Checkout_RecipientTitle"]</span>
                </h4>
                <p><span class="text-muted">@L["Label_TenNguoiNhan"]:</span> <strong class="text-charcoal">@Model.TenNguoiNhan</strong></p>
                <p><span class="text-muted">@L["Label_SDTNguoiNhan"]:</span> <strong class="text-charcoal font-mono">@Model.SdtNguoiNhan</strong></p>
                <p><span class="text-muted">@L["Label_DiaChiGiao"]:</span> <strong class="text-charcoal">@Model.DiaChiGiao</strong></p>
                @if (!string.IsNullOrWhiteSpace(Model.GhiChu))
                {
                    <p><span class="text-muted">@L["Label_GhiChu"]:</span> <span class="italic text-charcoal">@Model.GhiChu</span></p>
                }
            </div>

            <!-- Cột thanh toán (Điều chỉnh 4: Nút "Thanh toán ngay" nếu là Online chưa thanh toán và cờ mô phỏng bật) -->
            <div class="space-y-2.5">
                <h4 class="font-bold text-charcoal uppercase tracking-wider text-[11px] border-b border-borderLight pb-1.5 flex items-center gap-1.5">
                    <i class="ph-fill ph-credit-card text-primary"></i>
                    <span>@L["Checkout_PaymentTitle"]</span>
                </h4>
                <p>
                    <span class="text-muted">@L["Label_PhuongThucThanhToan"]:</span>
                    <strong class="text-charcoal">@LocHelper.GetPaymentMethodLabel(Model.ThanhToan?.TenPT ?? "")</strong>
                </p>
                <div class="flex items-center gap-2">
                    <span class="text-muted">@L["Label_TrangThaiThanhToan"]:</span>
                    <span class="px-2.5 py-0.5 rounded text-[11px] font-bold @(Model.ThanhToan?.TrangThai == WebsiteBanMyPham.Constants.TrangThaiThanhToanConstant.DaThanhToan ? "bg-statusSuccess/15 text-statusSuccess" : "bg-statusWarning/15 text-statusWarning")">
                        @LocHelper.GetPaymentStatusLabel(Model.ThanhToan?.TrangThai ?? "")
                    </span>
                </div>

                <!-- Điều chỉnh 4: Nút Thanh toán ngay cho đơn Online chưa thanh toán -->
                @if (canPayNow)
                {
                    <div class="pt-2">
                        <a asp-controller="ThanhToan" asp-action="MoPhong" asp-route-maDH="@Model.MaDH"
                           class="inline-flex items-center gap-2 px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                            <i class="ph-bold ph-credit-card"></i>
                            <span>@L["PaymentSim_BtnSuccess"]</span>
                        </a>
                    </div>
                }
            </div>
        </div>

        <!-- Danh sách sản phẩm trong đơn -->
        <div class="p-5 sm:p-6 space-y-3">
            <h4 class="font-bold text-charcoal uppercase tracking-wider text-[11px] flex items-center gap-1.5">
                <i class="ph-fill ph-shopping-bag text-primary"></i>
                <span>@L["Checkout_OrderSummaryTitle"]</span>
            </h4>

            <div class="divide-y divide-borderLight border border-borderLight rounded-btn overflow-hidden">
                @foreach (var sp in Model.ChiTiet)
                {
                    <div class="p-3.5 flex items-center justify-between gap-4 text-xs bg-surface hover:bg-cream/30 transition">
                        <div class="flex items-center gap-3 min-w-0">
                            <img src="@(string.IsNullOrEmpty(sp.DuongDanAnh) ? "/images/placeholder.svg" : sp.DuongDanAnh)"
                                 alt="@sp.TenSP"
                                 onerror="this.src='/images/placeholder.svg'"
                                 class="w-12 h-12 rounded object-cover border border-borderLight shrink-0" />
                            <div class="min-w-0 space-y-0.5">
                                <p class="font-bold text-charcoal line-clamp-1">@sp.TenSP</p>
                                <p class="text-[11px] text-muted">@LocHelper.FormatCurrency(sp.DonGia) × @sp.SoLuong</p>
                            </div>
                        </div>
                        <span class="font-bold text-charcoal shrink-0">@LocHelper.FormatCurrency(sp.ThanhTien)</span>
                    </div>
                }
            </div>
        </div>

        <!-- Chi tiết thanh toán -->
        <div class="p-5 sm:p-6 bg-cream/40 space-y-2 text-xs">
            <div class="flex justify-between text-muted">
                <span>@L["Checkout_Subtotal"]:</span>
                <span class="font-bold text-charcoal">@LocHelper.FormatCurrency(Model.TongTienHang)</span>
            </div>
            @if (Model.TienGiam > 0)
            {
                <div class="flex justify-between text-muted">
                    <span>@L["Checkout_Discount"] @(!string.IsNullOrEmpty(Model.CodeKM) ? $"({Model.CodeKM})" : ""):</span>
                    <span class="font-bold text-statusSuccess">-@LocHelper.FormatCurrency(Model.TienGiam)</span>
                </div>
            }
            <div class="flex justify-between items-center text-sm font-bold text-charcoal pt-2 border-t border-borderLight">
                <span>@L["Checkout_Total"]:</span>
                <span class="text-lg sm:text-xl text-primary font-bold">@LocHelper.FormatCurrency(Model.TongThanhToan)</span>
            </div>
        </div>
    </div>

    <!-- Hai nút điều hướng hành động -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
        <a asp-controller="SanPham" asp-action="Index"
           class="px-6 py-2.5 bg-cream hover:bg-pastel text-charcoal text-xs font-bold rounded-btn border border-borderLight transition flex items-center gap-2 shadow-sm">
            <i class="ph-bold ph-shopping-bag"></i>
            <span>@L["OrderSuccess_ContinueShopping"]</span>
        </a>

        <!-- Nút Xem đơn hàng của tôi (Liên kết tới DonHang/Index - sẽ hoàn thiện ở Bước 5E) -->
        <a asp-controller="DonHang" asp-action="Index"
           class="px-6 py-2.5 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition flex items-center gap-2 shadow-sm">
            <i class="ph-bold ph-clipboard-text"></i>
            <span>@L["OrderSuccess_ViewMyOrders"]</span>
        </a>
    </div>
</div>
