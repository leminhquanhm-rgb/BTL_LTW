@{
    ViewData["Title"] = L["Privacy_Title"].Value;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-12">
    <div class="bg-surface p-6 sm:p-10 rounded-card border border-borderLight shadow-soft space-y-6">
        <div class="border-b border-borderLight pb-4">
            <span class="text-xs font-bold uppercase tracking-wider text-primary">@L["Brand_Name"]</span>
            <h1 class="text-2xl sm:text-3xl font-bold text-charcoal font-serif mt-1">@L["Privacy_Title"]</h1>
        </div>
        
        <div class="space-y-4 text-sm text-charcoal leading-relaxed">
            <p>@L["Privacy_Content"]</p>
            <p>@L["Privacy_SubContent"]</p>
        </div>

        <div class="pt-4 border-t border-borderLight">
            <a asp-controller="TrangChu" asp-action="Index" class="inline-flex items-center gap-1.5 px-4 py-2 bg-cream hover:bg-pastel/60 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
        </div>
    </div>
</div>
