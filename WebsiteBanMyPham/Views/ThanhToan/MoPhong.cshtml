@model WebsiteBanMyPham.ViewModels.DonHangKhachChiTietViewModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<SharedResource> L
@inject WebsiteBanMyPham.Helpers.ILocalizationHelper LocHelper
@{
    ViewData["Title"] = L["PaymentSim_PageTitle"].Value;
}

<div class="max-w-4xl mx-auto px-4 sm:px-6 py-8 sm:py-12 space-y-8">
    <!-- Header trang -->
    <div class="text-center">
        <h1 class="text-xl sm:text-2xl font-serif font-bold text-charcoal">@L["PaymentSim_PageTitle"]</h1>
    </div>

    <!-- Thông báo lỗi khi thanh toán thất bại (chỉ hiện MỘT thông báo cụ thể, không hiện tiêu đề chung) -->
    @if (!ViewData.ModelState.IsValid)
    {
        var firstError = ViewData.ModelState.Values
            .SelectMany(v => v.Errors)
            .Select(e => e.ErrorMessage)
            .FirstOrDefault(msg => !string.IsNullOrWhiteSpace(msg));

        if (!string.IsNullOrWhiteSpace(firstError))
        {
            <div class="p-4 rounded-card bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs flex items-center gap-2" role="alert">
                <i class="ph-fill ph-x-circle text-base shrink-0"></i>
                <span>@firstError</span>
            </div>
        }
    }

    <!-- Bố cục 2 cột desktop (5:7), 1 cột mobile -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 sm:gap-8 items-start">

        <!-- CỘT TRÁI: THÔNG TIN ĐƠN HÀNG (lg:col-span-5) -->
        <div class="lg:col-span-5 bg-surface rounded-card border border-borderLight shadow-soft p-5 sm:p-6 space-y-4">
            <h2 class="text-sm font-bold text-charcoal border-b border-borderLight pb-3 flex items-center gap-2">
                <i class="ph-bold ph-receipt text-primary text-base"></i>
                <span>@L["PaymentSim_OrderInfo"]</span>
            </h2>

            <div class="space-y-2.5 text-xs">
                <div class="flex justify-between items-center">
                    <span class="text-muted">@L["PaymentSim_OrderCode"]</span>
                    <span class="font-bold font-mono text-primary text-sm">@LocHelper.MaDonHang(Model.MaDH)</span>
                </div>

                <div class="flex justify-between items-start gap-2">
                    <span class="text-muted shrink-0">@L["Payment_RecipientInfo"]</span>
                    <div class="text-right">
                        <p class="font-semibold text-charcoal">@Model.TenNguoiNhan</p>
                        <p class="font-mono text-muted text-[11px]">@Model.SdtNguoiNhan</p>
                    </div>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.DiaChiGiao))
                {
                    <div class="text-[11px] text-muted bg-cream/50 p-2.5 rounded-btn border border-borderLight/60 leading-relaxed">
                        @Model.DiaChiGiao
                    </div>
                }
            </div>

            <!-- Danh sách sản phẩm rút gọn -->
            @if (Model.ChiTiet != null && Model.ChiTiet.Any())
            {
                <div class="pt-1">
                    <span class="text-[11px] font-bold text-charcoal uppercase tracking-wider block mb-2">
                        @L["PaymentSim_ProductList"] (@Model.ChiTiet.Count)
                    </span>
                    <div class="space-y-2 border-t border-b border-borderLight py-3 max-h-48 overflow-y-auto pr-1">
                        @foreach (var sp in Model.ChiTiet)
                        {
                            <div class="flex items-center justify-between text-xs gap-3">
                                <div class="truncate">
                                    <p class="text-charcoal font-medium truncate" title="@sp.TenSP">@sp.TenSP</p>
                                    <span class="text-muted text-[11px]">× @sp.SoLuong</span>
                                </div>
                                <span class="font-mono text-charcoal font-semibold shrink-0">
                                    @LocHelper.FormatCurrency(sp.DonGia * sp.SoLuong)
                                </span>
                            </div>
                        }
                    </div>
                </div>
            }

            <!-- Chi tiết tiền & Tổng tiền nổi bật -->
            <div class="space-y-2 text-xs pt-1">
                <div class="flex justify-between items-center text-muted">
                    <span>@L["PaymentSim_Subtotal"]</span>
                    <span class="font-mono">@LocHelper.FormatCurrency(Model.TongTienHang)</span>
                </div>

                @if (Model.TienGiam > 0)
                {
                    <div class="flex justify-between items-center text-statusSuccess font-semibold">
                        <span>@L["PaymentSim_Discount"] @(!string.IsNullOrEmpty(Model.CodeKM) ? $"({Model.CodeKM})" : "")</span>
                        <span class="font-mono">-@LocHelper.FormatCurrency(Model.TienGiam)</span>
                    </div>
                }

                <div class="pt-2 border-t border-borderLight flex justify-between items-center">
                    <span class="font-bold text-charcoal">@L["PaymentSim_Amount"]</span>
                    <span class="text-xl sm:text-2xl font-bold text-primary font-mono">
                        @LocHelper.FormatCurrency(Model.TongThanhToan)
                    </span>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: QUÉT MÃ ĐỂ THANH TOÁN (lg:col-span-7) -->
        <div class="lg:col-span-7 bg-surface rounded-card border border-borderLight shadow-soft p-6 sm:p-7 text-center space-y-5">
            <!-- 1. Tiêu đề: Quét mã để thanh toán -->
            <h2 class="text-base font-bold text-charcoal flex items-center justify-center gap-2">
                <i class="ph-bold ph-qr-code text-primary text-lg"></i>
                <span>@L["PaymentSim_ScanToPay"]</span>
            </h2>

            <!-- 2. Ảnh QR tĩnh (hoặc khung thay thế gọn gàng khi ảnh lỗi) -->
            <div class="flex items-center justify-center">
                <div class="relative w-[220px] h-[220px] flex items-center justify-center">
                    <img id="qrImage"
                         src="~/images/thanh-toan/qr-thanh-toan.png"
                         asp-append-version="true"
                         alt="@L["Payment_QrImageAlt"]"
                         class="w-[220px] h-[220px] object-contain rounded-xl border border-borderLight shadow-sm block bg-white"
                         onerror="this.style.display='none'; var fb = document.getElementById('qrFallback'); if (fb) fb.style.display='flex';" />

                    <div id="qrFallback"
                         style="display: none;"
                         class="w-[220px] h-[220px] bg-white rounded-xl border border-dashed border-borderLight flex-col items-center justify-center p-4 text-center text-muted">
                        <i class="ph ph-qr-code text-5xl mb-2 text-primary/40"></i>
                        <span class="text-xs font-semibold text-charcoal">@L["Payment_QrFallback"]</span>
                        <span class="text-[11px] font-mono text-muted mt-1 break-all">@LocHelper.MaDonHang(Model.MaDH)</span>
                    </div>
                </div>
            </div>

            <!-- 3. Số tiền & 4. Dòng "Nội dung chuyển khoản: <mã đơn>" -->
            <div class="space-y-1">
                <p class="text-2xl font-bold text-primary font-mono tracking-tight">
                    @LocHelper.FormatCurrency(Model.TongThanhToan)
                </p>
                <p class="text-xs text-charcoal">
                    <span class="text-muted">@L["PaymentSim_TransferContent"]</span>
                    <strong class="font-mono font-bold text-primary ml-1">@LocHelper.MaDonHang(Model.MaDH)</strong>
                </p>
            </div>

            <!-- 5. 3 bước hướng dẫn -->
            <div class="bg-cream/60 rounded-btn p-3.5 border border-borderLight/80 text-left text-xs space-y-2 max-w-md mx-auto">
                <div class="flex items-center gap-2.5 text-charcoal font-medium">
                    <span class="w-5 h-5 rounded-full bg-pastel text-primary text-[11px] font-bold flex items-center justify-center shrink-0">1</span>
                    <span>@L["PaymentSim_Step1"]</span>
                </div>
                <div class="flex items-center gap-2.5 text-charcoal font-medium">
                    <span class="w-5 h-5 rounded-full bg-pastel text-primary text-[11px] font-bold flex items-center justify-center shrink-0">2</span>
                    <span>@L["PaymentSim_Step2"]</span>
                </div>
                <div class="flex items-center gap-2.5 text-charcoal font-medium">
                    <span class="w-5 h-5 rounded-full bg-pastel text-primary text-[11px] font-bold flex items-center justify-center shrink-0">3</span>
                    <span>@L["PaymentSim_Step3"]</span>
                </div>
            </div>

            <!-- 6. Nút Thanh toán & 7. Nút viền "Quay lại đơn hàng" -->
            <div class="space-y-3 pt-1 max-w-md mx-auto">
                <!-- Nút chính: Thanh toán -->
                <form asp-controller="ThanhToan" asp-action="XuLy" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="maDH" value="@Model.MaDH" />
                    <input type="hidden" name="thanhCong" value="true" />
                    <button type="submit"
                            class="w-full py-3.5 px-6 bg-primary hover:bg-primaryHover text-white font-bold text-xs sm:text-sm rounded-btn transition shadow-sm flex items-center justify-center gap-2">
                        <i class="ph-bold ph-check text-base"></i>
                        <span>@L["PaymentSim_BtnPaid"]</span>
                    </button>
                </form>

                <!-- Nút viền: Quay lại đơn hàng -->
                <a asp-controller="DatHang" asp-action="ThanhCong" asp-route-maDH="@Model.MaDH"
                   class="w-full py-2.5 px-4 bg-transparent hover:bg-cream text-charcoal font-semibold text-xs rounded-btn border border-borderLight transition flex items-center justify-center gap-1.5">
                    <i class="ph-bold ph-arrow-left text-xs"></i>
                    <span>@L["PaymentSim_BtnBack"]</span>
                </a>
            </div>
        </div>

    </div>
</div>
