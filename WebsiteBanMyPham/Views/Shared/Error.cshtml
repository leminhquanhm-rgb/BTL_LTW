@model ErrorViewModel
@{
    ViewData["Title"] = L["Error_Title"].Value;
}

<div class="max-w-2xl mx-auto px-4 py-16 text-center space-y-6">
    <div class="w-16 h-16 mx-auto rounded-full bg-[#FCEAEA] text-statusDanger flex items-center justify-center text-3xl">
        <i class="ph-fill ph-warning-octagon"></i>
    </div>
    
    <div class="space-y-2">
        <h1 class="text-2xl sm:text-3xl font-bold font-serif text-charcoal">@L["Error_Title"]</h1>
        <p class="text-sm text-muted">@L["Error_Message"]</p>
    </div>

    @if (Model?.ShowRequestId == true)
    {
        <div class="inline-block p-3 bg-surface border border-borderLight rounded-btn text-xs font-mono text-muted">
            <span>@L["Error_RequestId"]:</span> <strong class="text-charcoal">@Model.RequestId</strong>
        </div>
    }

    <div class="pt-4">
        <a asp-controller="TrangChu" asp-action="Index" class="inline-flex items-center gap-2 px-6 py-2.5 bg-primary hover:bg-primaryHover text-white text-xs font-semibold rounded-btn transition shadow-sm">
            <i class="ph ph-house"></i> @L["Error_BackHome"]
        </a>
    </div>
</div>
