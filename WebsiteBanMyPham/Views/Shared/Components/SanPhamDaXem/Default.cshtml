@model IEnumerable<WebsiteBanMyPham.ViewModels.SanPhamItemViewModel>

@if (Model != null && Model.Any())
{
    <section class="space-y-4 pt-4 border-t border-borderLight/60">
        <div class="border-b border-borderLight pb-3">
            <h3 class="font-serif text-lg sm:text-xl font-bold text-charcoal">@L["Product_RecentlyViewed_Title"]</h3>
            <p class="text-xs text-muted">@L["Product_RecentlyViewed_Subtitle"]</p>
        </div>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-4">
            @foreach (var sp in Model)
            {
                <partial name="_ProductCardPartial" model="sp" />
            }
        </div>
    </section>
}

