@model WebsiteBanMyPham.ViewModels.PaginatedList<WebsiteBanMyPham.ViewModels.Admin.TonKhoListItemViewModel>
@{
    ViewData["Title"] = L["Admin_Inventory_Title"].Value;
    var filter = ViewBag.Filter as WebsiteBanMyPham.ViewModels.Admin.TonKhoFilterViewModel ?? new WebsiteBanMyPham.ViewModels.Admin.TonKhoFilterViewModel();
    var danhMucs = ViewBag.DanhMucs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
}

<div class="space-y-6">
    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusSuccess/15 border border-statusSuccess/30 text-statusSuccess text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-check-circle text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusDanger/15 border border-statusDanger/30 text-statusDanger text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-warning-circle text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Header quản lý tồn kho & xuất Excel -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-surface p-5 rounded-card border border-borderLight shadow-soft">
        <div>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Inventory_Title"]</h1>
            <p class="text-xs text-muted mt-0.5">@L["Admin_Inventory_List"] (@Model.TotalItems)</p>
        </div>
        <div class="flex items-center gap-2.5">
            <a asp-area="Admin" asp-controller="Dashboard" asp-action="XuatSanPhamTonKho" 
               class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition flex items-center gap-1.5 shadow-sm">
                <i class="ph-bold ph-file-xls text-statusSuccess text-base"></i> @L["Admin_Inventory_Export"]
            </a>
            <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" 
               class="px-4 py-2 bg-surface hover:bg-cream text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition flex items-center gap-1.5 shadow-sm">
                <i class="ph-bold ph-package text-primary"></i> @L["Admin_Nav_Products"]
            </a>
        </div>
    </div>

    <!-- Bộ lọc & Tìm kiếm -->
    <div class="bg-surface p-4 rounded-card border border-borderLight shadow-soft">
        <form method="get" asp-area="Admin" asp-controller="TonKho" asp-action="Index" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
            <div class="lg:col-span-2">
                <label class="block text-[11px] font-bold text-charcoal/70 mb-1">@L["Common_Search"]</label>
                <input type="text" name="keyword" value="@filter.Keyword" 
                       placeholder="@L["Admin_Inventory_SearchPlaceholder"]" 
                       class="w-full px-3 py-2 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
            </div>

            <div>
                <label class="block text-[11px] font-bold text-charcoal/70 mb-1">@L["Admin_Product_Category"]</label>
                <select name="maDM" class="w-full px-3 py-2 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary">
                    <option value="">@L["Product_AllCategories"]</option>
                    @foreach (var dm in danhMucs)
                    {
                        <option value="@dm.Value" selected="@(filter.MaDM.HasValue && filter.MaDM.Value.ToString() == dm.Value)">@dm.Text</option>
                    }
                </select>
            </div>

            <div>
                <label class="block text-[11px] font-bold text-charcoal/70 mb-1">@L["Admin_Product_Stock"]</label>
                <select name="tinhTrangTon" class="w-full px-3 py-2 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary">
                    <option value="tatCa" selected="@(string.IsNullOrEmpty(filter.TinhTrangTon) || filter.TinhTrangTon == "tatCa")">@L["Admin_Product_Filter_Stock_All"]</option>
                    <option value="sapHet" selected="@(filter.TinhTrangTon == "sapHet")">@L["Admin_Product_Filter_Stock_Low"]</option>
                    <option value="hetHang" selected="@(filter.TinhTrangTon == "hetHang")">@L["Admin_Product_Filter_Stock_Out"]</option>
                </select>
            </div>

            <div class="flex items-end gap-2">
                <button type="submit" class="w-full px-4 py-2 bg-charcoal hover:bg-charcoal/90 text-white text-xs font-bold rounded-btn transition flex items-center justify-center gap-1.5 shadow-sm">
                    <i class="ph-bold ph-magnifying-glass"></i> @L["Common_Search"]
                </button>
                @if (!string.IsNullOrWhiteSpace(filter.Keyword) || filter.MaDM.HasValue || (!string.IsNullOrEmpty(filter.TinhTrangTon) && filter.TinhTrangTon != "tatCa"))
                {
                    <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" 
                       class="px-3 py-2 bg-cream hover:bg-pastel/40 text-muted text-xs font-semibold rounded-btn border border-borderLight transition whitespace-nowrap">
                        @L["Common_Cancel"]
                    </a>
                }
            </div>
        </form>
    </div>

    <!-- Bảng danh sách Tồn kho -->
    <div class="bg-surface rounded-card border border-borderLight shadow-soft overflow-hidden">
        <div class="overflow-x-auto">
            <table class="w-full text-left text-xs divide-y divide-borderLight">
                <thead>
                    <tr class="bg-cream text-charcoal font-bold uppercase tracking-wider text-[11px]">
                        <th class="p-3.5 w-14">ID</th>
                        <th class="p-3.5 w-16 text-center">@L["Admin_Product_Images"]</th>
                        <th class="p-3.5">@L["Admin_Product_Name"]</th>
                        <th class="p-3.5">@L["Admin_Product_Category"]</th>
                        <th class="p-3.5">@L["Admin_Product_Brand"]</th>
                        <th class="p-3.5 text-center">@L["Admin_Product_Stock"]</th>
                        <th class="p-3.5 text-center">@L["Admin_Product_WarningThreshold"]</th>
                        <th class="p-3.5 text-center">@L["Admin_Product_DisplayStatus"]</th>
                        <th class="p-3.5 text-right w-48">@L["Admin_Category_Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-borderLight">
                    @if (Model.Items.Count == 0)
                    {
                        <tr>
                            <td colspan="9" class="p-8 text-center text-muted">
                                <i class="ph ph-package text-3xl mb-1 block"></i>
                                @L["Admin_Product_Images_Empty"]
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model.Items)
                        {
                            <tr class="hover:bg-cream/40 transition">
                                <td class="p-3.5 font-mono text-muted">#@(item.MaSP)</td>
                                <td class="p-3.5 text-center">
                                    <img src="@item.AnhChinh" alt="@item.TenSP" 
                                         onerror="this.src='/images/placeholder.svg'"
                                         class="w-10 h-10 object-cover rounded-btn border border-borderLight mx-auto" />
                                </td>
                                <td class="p-3.5 font-bold text-charcoal max-w-[200px]">
                                    <a asp-area="Admin" asp-controller="SanPham" asp-action="Sua" asp-route-id="@item.MaSP" class="hover:text-primary transition line-clamp-2">
                                        @item.TenSP
                                    </a>
                                </td>
                                <td class="p-3.5 text-charcoal/80">
                                    <span class="inline-block px-2 py-0.5 rounded bg-cream border border-borderLight/80 text-[11px]">
                                        @item.TenDanhMuc
                                    </span>
                                </td>
                                <td class="p-3.5 text-charcoal/80">
                                    <span class="inline-block px-2 py-0.5 rounded bg-cream border border-borderLight/80 text-[11px]">
                                        @item.TenThuongHieu
                                    </span>
                                </td>
                                <td class="p-3.5 text-center font-bold">
                                    @if (item.IsHetHang)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-statusDanger/15 text-statusDanger text-[11px] font-bold">
                                            0 (@L["Admin_Inventory_OutOfStock_Badge"])
                                        </span>
                                    }
                                    else if (item.IsSapHet)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-statusWarning/15 text-statusWarning text-[11px] font-bold">
                                            @item.SoLuongTon (@L["Admin_Inventory_LowStock_Badge"])
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-statusSuccess/15 text-statusSuccess text-[11px] font-bold">
                                            @item.SoLuongTon (@L["Admin_Inventory_InStock_Badge"])
                                        </span>
                                    }
                                </td>
                                <td class="p-3.5 text-center font-mono text-muted text-xs">
                                    @item.NguongCanhBao
                                </td>
                                <td class="p-3.5 text-center">
                                    @if (item.IsDangBan)
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-statusSuccess/15 text-statusSuccess font-bold text-[11px]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-statusSuccess"></span>
                                            @L[item.TrangThaiHienThiKey]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full bg-statusWarning/15 text-statusWarning font-bold text-[11px]">
                                            <span class="w-1.5 h-1.5 rounded-full bg-statusWarning"></span>
                                            @L[item.TrangThaiHienThiKey]
                                        </span>
                                    }
                                </td>
                                <td class="p-3.5 text-right">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Nút Điều chỉnh tồn kho -->
                                        <button type="button" 
                                                class="px-2.5 py-1 bg-cream hover:bg-pastel/50 text-charcoal rounded font-semibold transition border border-borderLight btn-open-adjust"
                                                data-id="@item.MaSP"
                                                data-name="@item.TenSP"
                                                data-stock="@item.SoLuongTon">
                                            <i class="ph-bold ph-plus-minus text-primary mr-0.5"></i> @L["Admin_Inventory_Adjust"]
                                        </button>

                                        <!-- Nút Cập nhật ngưỡng cảnh báo -->
                                        <button type="button" 
                                                class="px-2 py-1 text-muted hover:text-charcoal hover:bg-cream rounded font-semibold transition border border-borderLight btn-open-threshold"
                                                data-id="@item.MaSP"
                                                data-name="@item.TenSP"
                                                data-threshold="@item.NguongCanhBao"
                                                title="@L["Admin_Inventory_Threshold"]">
                                            <i class="ph-bold ph-gear"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <!-- Phân trang -->
        @if (Model.TotalPages > 1)
        {
            <div class="p-4 border-t border-borderLight flex flex-wrap items-center justify-between gap-3">
                <span class="text-xs text-muted">
                    Trang @Model.PageIndex / @Model.TotalPages (@Model.TotalItems @L["Admin_Nav_Products"].Value.ToLower())
                </span>
                <div class="flex items-center gap-1.5">
                    @if (Model.PageIndex > 1)
                    {
                        <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" 
                           asp-route-trang="@(Model.PageIndex - 1)" 
                           asp-route-keyword="@filter.Keyword" 
                           asp-route-maDM="@filter.MaDM"
                           asp-route-tinhTrangTon="@filter.TinhTrangTon"
                           class="px-3 py-1.5 bg-cream hover:bg-pastel/50 rounded-btn text-xs font-semibold border border-borderLight text-charcoal transition">
                            ←
                        </a>
                    }
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.PageIndex)
                        {
                            <span class="px-3 py-1.5 bg-primary text-white rounded-btn text-xs font-bold">@i</span>
                        }
                        else if (i == 1 || i == Model.TotalPages || (i >= Model.PageIndex - 2 && i <= Model.PageIndex + 2))
                        {
                            <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" 
                               asp-route-trang="@i" 
                               asp-route-keyword="@filter.Keyword" 
                               asp-route-maDM="@filter.MaDM"
                               asp-route-tinhTrangTon="@filter.TinhTrangTon"
                               class="px-3 py-1.5 bg-cream hover:bg-pastel/50 rounded-btn text-xs font-semibold border border-borderLight text-charcoal transition">
                                @i
                            </a>
                        }
                        else if (i == Model.PageIndex - 3 || i == Model.PageIndex + 3)
                        {
                            <span class="px-1 text-xs text-muted">...</span>
                        }
                    }
                    @if (Model.PageIndex < Model.TotalPages)
                    {
                        <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" 
                           asp-route-trang="@(Model.PageIndex + 1)" 
                           asp-route-keyword="@filter.Keyword" 
                           asp-route-maDM="@filter.MaDM"
                           asp-route-tinhTrangTon="@filter.TinhTrangTon"
                           class="px-3 py-1.5 bg-cream hover:bg-pastel/50 rounded-btn text-xs font-semibold border border-borderLight text-charcoal transition">
                            →
                        </a>
                    }
                </div>
            </div>
        }
    </div>
</div>

<!-- Modal Điều chỉnh Tồn kho (+ / - delta) -->
<div id="adjustModal" class="fixed inset-0 z-50 bg-charcoal/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-surface rounded-card border border-borderLight p-6 max-w-md w-full shadow-hover space-y-4">
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-pastel/40 text-primary flex items-center justify-center shrink-0">
                <i class="ph-bold ph-plus-minus text-xl"></i>
            </div>
            <div>
                <h3 class="font-bold text-charcoal text-base">@L["Admin_Inventory_Adjust"]</h3>
                <p id="adjustProductName" class="text-xs text-muted mt-0.5 line-clamp-1"></p>
                <p class="text-xs text-charcoal mt-1">@L["Admin_Product_Stock"]: <strong id="currentStockDisplay">0</strong></p>
            </div>
        </div>

        <form method="post" asp-area="Admin" asp-controller="TonKho" asp-action="DieuChinh" id="formAdjustStock" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaSP" id="adjustMaSP" />
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-charcoal">
                    Số lượng điều chỉnh (&Delta;) <span class="text-statusDanger">*</span>
                </label>
                <input type="number" name="Delta" id="adjustDelta" required
                       data-msg-required="@string.Format(L["Validation_Required"].Value, L["Admin_Inventory_AdjustDelta"].Value)"
                       placeholder="@L["Admin_Inventory_Adjust_Placeholder"]"
                       class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                <span class="text-[11px] text-muted block">@L["Admin_Inventory_Adjust_Hint"]</span>
            </div>

            <!-- Xem trước tồn mới -->
            <div id="previewStockContainer" class="p-3 rounded-btn bg-cream border border-borderLight flex items-center justify-between text-xs">
                <span class="text-muted">Tồn sau điều chỉnh:</span>
                <span id="previewStockValue" class="font-bold text-charcoal">0</span>
            </div>
            <p id="previewStockError" class="text-statusDanger text-[11px] hidden">Số lượng điều chỉnh sẽ làm tồn kho âm. Vui lòng nhập lại.</p>

            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button type="button" id="btnAdjustCancel" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </button>
                <button type="submit" id="btnAdjustSubmit" class="px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                    @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Modal Cập nhật Ngưỡng cảnh báo -->
<div id="thresholdModal" class="fixed inset-0 z-50 bg-charcoal/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-surface rounded-card border border-borderLight p-6 max-w-md w-full shadow-hover space-y-4">
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-pastel/40 text-primary flex items-center justify-center shrink-0">
                <i class="ph-bold ph-gear text-xl"></i>
            </div>
            <div>
                <h3 class="font-bold text-charcoal text-base">@L["Admin_Product_WarningThreshold"]</h3>
                <p id="thresholdProductName" class="text-xs text-muted mt-0.5 line-clamp-1"></p>
            </div>
        </div>

        <form method="post" asp-area="Admin" asp-controller="TonKho" asp-action="CapNhatNguong" id="formThreshold" class="space-y-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="MaSP" id="thresholdMaSP" />
            <input type="hidden" name="ReturnUrl" value="@returnUrl" />

            <div class="space-y-1.5">
                <label class="block text-xs font-bold text-charcoal">
                    @L["Admin_Product_WarningThreshold"] <span class="text-statusDanger">*</span>
                </label>
                <input type="number" name="NguongCanhBao" id="inputNguongCanhBao" min="0" max="100000" required
                       data-msg-required="@string.Format(L["Validation_Required"].Value, L["Admin_Product_WarningThreshold"].Value)"
                       data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Product_WarningThreshold"].Value, 0)"
                       data-msg-max="@string.Format(L["Validation_Range"].Value, L["Admin_Product_WarningThreshold"].Value, 0, "100.000")"
                       class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                <span class="text-[11px] text-muted block">@L["Admin_Product_WarningThreshold_Hint"]</span>
            </div>

            <div class="flex items-center justify-end gap-2.5 pt-2">
                <button type="button" id="btnThresholdCancel" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </button>
                <button type="submit" class="px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                    @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Modal Điều chỉnh tồn kho
            var adjustModal = document.getElementById('adjustModal');
            var adjustMaSP = document.getElementById('adjustMaSP');
            var adjustProductName = document.getElementById('adjustProductName');
            var currentStockDisplay = document.getElementById('currentStockDisplay');
            var adjustDelta = document.getElementById('adjustDelta');
            var previewStockValue = document.getElementById('previewStockValue');
            var previewStockError = document.getElementById('previewStockError');
            var btnAdjustCancel = document.getElementById('btnAdjustCancel');
            var btnAdjustSubmit = document.getElementById('btnAdjustSubmit');

            var currentStock = 0;

            function updatePreview() {
                var deltaVal = parseInt(adjustDelta.value, 10);
                if (isNaN(deltaVal)) {
                    previewStockValue.textContent = currentStock;
                    previewStockError.classList.add('hidden');
                    btnAdjustSubmit.disabled = false;
                    return;
                }

                var nextStock = currentStock + deltaVal;
                previewStockValue.textContent = nextStock;

                if (nextStock < 0 || deltaVal === 0) {
                    previewStockError.classList.remove('hidden');
                    btnAdjustSubmit.disabled = true;
                } else {
                    previewStockError.classList.add('hidden');
                    btnAdjustSubmit.disabled = false;
                }
            }

            adjustDelta.addEventListener('input', updatePreview);

            document.querySelectorAll('.btn-open-adjust').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.dataset.id;
                    var name = this.dataset.name;
                    var stock = parseInt(this.dataset.stock, 10) || 0;

                    currentStock = stock;
                    adjustMaSP.value = id;
                    adjustProductName.textContent = name;
                    currentStockDisplay.textContent = stock;
                    adjustDelta.value = '';
                    previewStockValue.textContent = stock;
                    previewStockError.classList.add('hidden');
                    btnAdjustSubmit.disabled = false;

                    adjustModal.classList.remove('hidden');
                    adjustDelta.focus();
                });
            });

            btnAdjustCancel.addEventListener('click', function () {
                adjustModal.classList.add('hidden');
            });

            // Modal Cập nhật ngưỡng
            var thresholdModal = document.getElementById('thresholdModal');
            var thresholdMaSP = document.getElementById('thresholdMaSP');
            var thresholdProductName = document.getElementById('thresholdProductName');
            var inputNguongCanhBao = document.getElementById('inputNguongCanhBao');
            var btnThresholdCancel = document.getElementById('btnThresholdCancel');

            document.querySelectorAll('.btn-open-threshold').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var id = this.dataset.id;
                    var name = this.dataset.name;
                    var threshold = this.dataset.threshold;

                    thresholdMaSP.value = id;
                    thresholdProductName.textContent = name;
                    inputNguongCanhBao.value = threshold;

                    thresholdModal.classList.remove('hidden');
                    inputNguongCanhBao.focus();
                });
            });

            btnThresholdCancel.addEventListener('click', function () {
                thresholdModal.classList.add('hidden');
            });
        });
    </script>
}

