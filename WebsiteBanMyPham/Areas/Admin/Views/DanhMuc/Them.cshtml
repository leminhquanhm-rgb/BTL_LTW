@model WebsiteBanMyPham.ViewModels.Admin.DanhMucFormViewModel
@{
    ViewData["Title"] = L["Admin_Category_Add"].Value;
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="flex items-center justify-between">
        <div>
            <a asp-area="Admin" asp-controller="DanhMuc" asp-action="Index" class="text-xs text-muted hover:text-primary transition flex items-center gap-1 mb-1">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Category_Add"]</h1>
        </div>
    </div>

    <!-- Form tạo mới -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft">
        <form method="post" asp-area="Admin" asp-controller="DanhMuc" asp-action="Them" class="space-y-5">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="p-3 bg-statusDanger/10 border border-statusDanger/30 rounded-btn text-statusDanger text-xs"></div>

            <!-- Tên danh mục -->
            <div class="space-y-1.5">
                <label asp-for="TenDM" class="block text-xs font-bold text-charcoal">
                    @L["Admin_Category_Name"] <span class="text-statusDanger">*</span>
                </label>
                <input asp-for="TenDM" 
                       placeholder="@L["Admin_Category_Name"]" 
                       maxlength="100"
                       class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                <span asp-validation-for="TenDM" class="text-statusDanger text-[11px] block"></span>
            </div>

            <!-- Mô tả -->
            <div class="space-y-1.5">
                <label asp-for="MoTa" class="block text-xs font-bold text-charcoal">
                    @L["Admin_Category_Desc"]
                </label>
                <textarea asp-for="MoTa" rows="4" 
                          placeholder="@L["Admin_Category_Desc"]" 
                          maxlength="500"
                          class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary"></textarea>
                <span asp-validation-for="MoTa" class="text-statusDanger text-[11px] block"></span>
            </div>

            <!-- Trạng thái -->
            <div class="pt-2">
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input asp-for="TrangThai" type="checkbox" class="w-4 h-4 rounded text-primary focus:ring-primary border-borderLight" />
                    <span class="text-xs font-semibold text-charcoal">@L["Admin_Category_Status"]</span>
                </label>
            </div>

            <!-- Nút hành động -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-borderLight">
                <a asp-area="Admin" asp-controller="DanhMuc" asp-action="Index" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                    @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

