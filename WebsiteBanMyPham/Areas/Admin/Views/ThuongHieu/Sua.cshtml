@model WebsiteBanMyPham.ViewModels.Admin.ThuongHieuFormViewModel
@{
    ViewData["Title"] = L["Admin_Brand_Edit"].Value;
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="flex items-center justify-between">
        <div>
            <a asp-area="Admin" asp-controller="ThuongHieu" asp-action="Index" class="text-xs text-muted hover:text-primary transition flex items-center gap-1 mb-1">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Brand_Edit"] #@Model.MaTH</h1>
        </div>
        <span class="text-xs text-muted">
            @L["Admin_Brand_ProductCount"]: <strong class="text-charcoal font-mono">@Model.SoLuongSanPham</strong>
        </span>
    </div>

    <!-- Form chỉnh sửa -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft">
        <form method="post" asp-area="Admin" asp-controller="ThuongHieu" asp-action="Sua" asp-route-id="@Model.MaTH" enctype="multipart/form-data" class="space-y-5">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaTH" />
            <input type="hidden" asp-for="LogoHienTai" />
            <input type="hidden" asp-for="SoLuongSanPham" />

            <div asp-validation-summary="ModelOnly" class="p-3 bg-statusDanger/10 border border-statusDanger/30 rounded-btn text-statusDanger text-xs"></div>

            <!-- Tên thương hiệu -->
            <div class="space-y-1.5">
                <label asp-for="TenTH" class="block text-xs font-bold text-charcoal">
                    @L["Admin_Brand_Name"] <span class="text-statusDanger">*</span>
                </label>
                <input asp-for="TenTH" 
                       placeholder="@L["Admin_Brand_Name"]" 
                       maxlength="100"
                       class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                <span asp-validation-for="TenTH" class="text-statusDanger text-[11px] block"></span>
            </div>

            <!-- Logo hiện tại & Tải logo mới -->
            <div class="space-y-3 p-4 bg-cream/50 rounded-btn border border-borderLight">
                <label class="block text-xs font-bold text-charcoal">
                    @L["Admin_Brand_Logo"]
                </label>

                @if (!string.IsNullOrWhiteSpace(Model.LogoHienTai))
                {
                    <div class="flex items-center gap-4">
                        <img src="@Model.LogoHienTai" alt="@Model.TenTH" class="w-16 h-16 object-contain rounded border border-borderLight bg-white p-1" />
                        <label class="flex items-center gap-2 cursor-pointer text-xs text-statusDanger font-semibold">
                            <input asp-for="XoaLogo" type="checkbox" class="w-4 h-4 rounded text-statusDanger focus:ring-statusDanger border-borderLight" />
                            @L["Admin_Brand_DeleteLogo"]
                        </label>
                    </div>
                }
                else
                {
                    <p class="text-xs text-muted italic">@L["Admin_Brand_NoLogo"]</p>
                }

                <div class="space-y-1 pt-1">
                    <span class="block text-[11px] font-semibold text-muted">@L["Admin_Brand_ChangeLogo"]:</span>
                    <input asp-for="LogoFile" type="file" accept=".jpg,.jpeg,.png,.webp"
                           class="w-full px-3.5 py-2 bg-white border border-borderLight rounded-btn text-xs text-charcoal file:mr-3 file:py-1.5 file:px-3 file:rounded-btn file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-white hover:file:bg-primaryHover cursor-pointer focus:outline-none" />
                    <p class="text-[11px] text-muted">@L["Admin_Brand_UploadHint"]</p>
                    <span asp-validation-for="LogoFile" class="text-statusDanger text-[11px] block"></span>
                </div>
            </div>

            <!-- Mô tả -->
            <div class="space-y-1.5">
                <label asp-for="MoTa" class="block text-xs font-bold text-charcoal">
                    @L["Admin_Brand_Desc"]
                </label>
                <textarea asp-for="MoTa" rows="4" 
                          placeholder="@L["Admin_Brand_Desc"]" 
                          maxlength="500"
                          class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary"></textarea>
                <span asp-validation-for="MoTa" class="text-statusDanger text-[11px] block"></span>
            </div>

            <!-- Trạng thái -->
            <div class="pt-2">
                <label class="flex items-center gap-2.5 cursor-pointer">
                    <input asp-for="TrangThai" type="checkbox" class="w-4 h-4 rounded text-primary focus:ring-primary border-borderLight" />
                    <span class="text-xs font-semibold text-charcoal">@L["Admin_Brand_Status"]</span>
                </label>
            </div>

            <!-- Nút hành động -->
            <div class="flex items-center justify-end gap-3 pt-4 border-t border-borderLight">
                <a asp-area="Admin" asp-controller="ThuongHieu" asp-action="Index" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                    @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

