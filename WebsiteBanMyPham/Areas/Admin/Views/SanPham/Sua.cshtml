@model WebsiteBanMyPham.ViewModels.Admin.SanPhamEditViewModel
@{
    ViewData["Title"] = L["Admin_Product_Edit"].Value;
    var danhMucs = ViewBag.DanhMucs as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    var thuongHieus = ViewBag.ThuongHieus as List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem> ?? new List<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();
    bool canAddImage = Model.DanhSachAnh.Count < 8;
}

@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
    <style>
        .ql-toolbar.ql-snow {
            border-top-left-radius: 6px;
            border-top-right-radius: 6px;
            border-color: #F0E4E8;
            background-color: #FFF9F5;
        }
        .ql-container.ql-snow {
            border-bottom-left-radius: 6px;
            border-bottom-right-radius: 6px;
            border-color: #F0E4E8;
            background-color: #FFFFFF;
            font-family: inherit;
            font-size: 13px;
            height: auto !important;
        }
        .ql-editor {
            min-height: 240px;
            max-height: 480px;
            overflow-y: auto;
        }
    </style>
}

<div class="max-w-4xl mx-auto space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="flex items-center justify-between">
        <div>
            <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="text-xs text-muted hover:text-primary transition flex items-center gap-1 mb-1">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Product_Edit"]: @Model.TenSP</h1>
            <p class="text-xs text-muted">ID: #@(Model.MaSP) &bull; @L["Label_NgayTao"]: @LocalizationHelper.FormatDateTime(Model.NgayTao)</p>
        </div>
        <a asp-area="" asp-controller="ChiTietSanPham" asp-action="Index" asp-route-id="@Model.MaSP" target="_blank"
           class="px-3.5 py-1.5 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition flex items-center gap-1 shadow-sm">
            <i class="ph ph-arrow-square-out"></i> @L["Common_Detail"]
        </a>
    </div>

    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusSuccess/15 border border-statusSuccess/30 text-statusSuccess text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-check-circle text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusDanger/15 border border-statusDanger/30 text-statusDanger text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-warning-circle text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Lưu ý về giá & tồn kho -->
    <div class="p-4 rounded-card bg-statusInfo/10 border border-statusInfo/30 text-charcoal text-xs flex items-start gap-2.5">
        <i class="ph-fill ph-info text-base text-statusInfo shrink-0 mt-0.5"></i>
        <div class="space-y-1">
            <p class="font-bold text-statusInfo">@L["Admin_Product_PriceEdit_Notice"]</p>
            <p class="text-muted leading-relaxed">
                Số lượng tồn hiện tại là <strong>@Model.SoLuongTon</strong>. Tồn kho được quản lý riêng biệt tại trang 
                <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" asp-route-keyword="@Model.TenSP" class="underline text-primary font-bold hover:text-primaryHover">
                    @L["Admin_Nav_Inventory"]
                </a> để đảm bảo tính toàn vẹn khi khách hàng đang đặt mua.
            </p>
        </div>
    </div>

    <!-- Form sửa thông tin sản phẩm -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft">
        <form method="post" asp-area="Admin" asp-controller="SanPham" asp-action="Sua" asp-route-id="@Model.MaSP" id="formSuaSanPham" class="space-y-6">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="MaSP" />
            <div asp-validation-summary="ModelOnly" class="p-3 bg-statusDanger/10 border border-statusDanger/30 rounded-btn text-statusDanger text-xs"></div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <!-- Tên sản phẩm -->
                <div class="space-y-1.5 md:col-span-2">
                    <label asp-for="TenSP" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Name"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="TenSP" maxlength="200"
                           class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                    <span asp-validation-for="TenSP" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Danh mục -->
                <div class="space-y-1.5">
                    <label asp-for="MaDM" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Category"] <span class="text-statusDanger">*</span>
                    </label>
                    <select asp-for="MaDM" class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary">
                        @foreach (var dm in danhMucs)
                        {
                            <option value="@dm.Value" selected="@(Model.MaDM.ToString() == dm.Value)">@dm.Text</option>
                        }
                    </select>
                    <span asp-validation-for="MaDM" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Thương hiệu -->
                <div class="space-y-1.5">
                    <label asp-for="MaTH" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Brand"] <span class="text-statusDanger">*</span>
                    </label>
                    <select asp-for="MaTH" class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary">
                        @foreach (var th in thuongHieus)
                        {
                            <option value="@th.Value" selected="@(Model.MaTH.ToString() == th.Value)">@th.Text</option>
                        }
                    </select>
                    <span asp-validation-for="MaTH" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Giá bán -->
                <div class="space-y-1.5">
                    <label asp-for="Gia" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Price"] (VNĐ) <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="Gia" type="number" min="0" step="1000"
                           class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                    <span asp-validation-for="Gia" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Giá gốc -->
                <div class="space-y-1.5">
                    <label asp-for="GiaGoc" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_OriginalPrice"] (VNĐ)
                    </label>
                    <input asp-for="GiaGoc" type="number" min="0" step="1000"
                           class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                    <span class="text-[11px] text-muted block">@L["Admin_Product_OriginalPrice_Hint"]</span>
                    <span asp-validation-for="GiaGoc" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Số lượng tồn (Chỉ đọc) -->
                <div class="space-y-1.5">
                    <label class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Stock"] (Chỉ đọc)
                    </label>
                    <div class="flex items-center gap-2">
                        <input type="text" value="@Model.SoLuongTon" readonly disabled
                               class="w-full px-3.5 py-2.5 bg-cream/70 border border-borderLight rounded-btn text-xs text-charcoal font-bold cursor-not-allowed" />
                        <a asp-area="Admin" asp-controller="TonKho" asp-action="Index" asp-route-keyword="@Model.TenSP" 
                           class="px-3 py-2.5 bg-cream hover:bg-pastel/40 text-charcoal border border-borderLight text-xs font-semibold rounded-btn transition whitespace-nowrap">
                            @L["Admin_Inventory_Adjust"]
                        </a>
                    </div>
                </div>

                <!-- Ngưỡng cảnh báo -->
                <div class="space-y-1.5">
                    <label asp-for="NguongCanhBao" class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_WarningThreshold"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="NguongCanhBao" type="number" min="0" max="100000"
                           class="w-full px-3.5 py-2.5 bg-cream border border-borderLight rounded-btn text-xs text-charcoal focus:outline-none focus:border-primary" />
                    <span class="text-[11px] text-muted block">@L["Admin_Product_WarningThreshold_Hint"]</span>
                    <span asp-validation-for="NguongCanhBao" class="text-statusDanger text-[11px] block"></span>
                </div>

                <!-- Trạng thái kinh doanh -->
                <div class="md:col-span-2 pt-1">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input asp-for="TrangThai" type="checkbox" class="w-4 h-4 rounded text-primary focus:ring-primary border-borderLight" />
                        <span class="text-xs font-semibold text-charcoal">@L["Admin_Product_Status_OnSale"]</span>
                    </label>
                </div>

                <!-- Mô tả chi tiết (Rich text Quill) -->
                <div class="space-y-1.5 md:col-span-2">
                    <label class="block text-xs font-bold text-charcoal">
                        @L["Admin_Product_Description"]
                    </label>
                    <!-- Điều chỉnh 6: MoTa đưa vào form qua IHtmlSanitizerService.Sanitize trước -->
                    <textarea id="rawMoTa" style="display:none;">@Model.MoTa</textarea>
                    <input type="hidden" asp-for="MoTa" id="MoTa" />
                    <div id="quill-editor"></div>
                    <span class="text-[11px] text-muted block">@L["Admin_Product_Description_Hint"]</span>
                    <span asp-validation-for="MoTa" class="text-statusDanger text-[11px] block"></span>
                </div>
            </div>

            <!-- Nút hành động -->
            <div class="flex items-center justify-end gap-3 pt-5 mt-2 border-t border-borderLight clear-both">
                <a asp-area="Admin" asp-controller="SanPham" asp-action="Index" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm">
                    @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>

    <!-- KHU VỰC QUẢN LÝ HÌNH ẢNH SẢN PHẨM -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft space-y-5">
        <div class="flex flex-wrap items-center justify-between gap-3 pb-3 border-b border-borderLight">
            <div>
                <h2 class="text-sm font-bold text-charcoal">@L["Admin_Product_Images"] (@Model.DanhSachAnh.Count/8)</h2>
                <p class="text-xs text-muted">@L["Admin_Product_Images_Hint"]</p>
            </div>
            @if (!canAddImage)
            {
                <span class="px-3 py-1 bg-statusWarning/15 text-statusWarning text-xs font-semibold rounded-btn">
                    @L["Admin_Product_Images_MaxExceeded"]
                </span>
            }
        </div>

        <!-- Form tải thêm 1 ảnh mới -->
        @if (canAddImage)
        {
            <form method="post" asp-area="Admin" asp-controller="SanPham" asp-action="ThemAnh" asp-route-id="@Model.MaSP" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3 p-4 bg-cream rounded-card border border-borderLight">
                @Html.AntiForgeryToken()
                <div class="flex-1 min-w-[240px]">
                    <input type="file" name="file" required accept=".jpg,.jpeg,.png,.webp"
                           class="w-full px-3 py-1.5 bg-surface border border-borderLight rounded-btn text-xs text-charcoal file:mr-3 file:py-1 file:px-2.5 file:rounded-btn file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-white hover:file:bg-primaryHover cursor-pointer" />
                </div>
                <button type="submit" class="px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition flex items-center gap-1.5 shadow-sm">
                    <i class="ph-bold ph-upload-simple"></i> @L["Admin_Product_Images_Upload"]
                </button>
            </form>
        }

        <!-- Gallery danh sách ảnh hiện tại -->
        @if (Model.DanhSachAnh.Count == 0)
        {
            <div class="p-8 text-center text-muted">
                <i class="ph ph-images text-3xl mb-1 block"></i>
                @L["Admin_Product_Images_Empty"]
            </div>
        }
        else
        {
            <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
                @foreach (var img in Model.DanhSachAnh)
                {
                    <div class="relative rounded-btn border border-borderLight overflow-hidden bg-cream group p-2 flex flex-col justify-between">
                        <div class="aspect-square rounded overflow-hidden bg-surface mb-2">
                            <img src="@img.DuongDan" alt="@Model.TenSP" 
                                 onerror="this.src='/images/placeholder.svg'"
                                 class="w-full h-full object-cover" />
                        </div>

                        <!-- Badge ảnh chính -->
                        <div class="flex items-center justify-between gap-1">
                            @if (img.LaAnhChinh)
                            {
                                <span class="px-2 py-0.5 rounded bg-primary text-white text-[10px] font-bold shadow-sm">
                                    @L["Admin_Product_Images_Primary"]
                                </span>
                            }
                            else
                            {
                                <form method="post" asp-area="Admin" asp-controller="SanPham" asp-action="DatAnhChinh" asp-route-id="@Model.MaSP" asp-route-maAnh="@img.MaAnh" class="inline-block">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="px-2 py-0.5 rounded bg-surface hover:bg-pastel/40 text-charcoal border border-borderLight text-[10px] font-semibold transition">
                                        @L["Admin_Product_Images_SetPrimary"]
                                    </button>
                                </form>
                            }

                            <!-- Nút xóa ảnh -->
                            <form method="post" asp-area="Admin" asp-controller="SanPham" asp-action="XoaAnh" asp-route-id="@Model.MaSP" asp-route-maAnh="@img.MaAnh" class="inline-block form-xoa-anh">
                                @Html.AntiForgeryToken()
                                <button type="button" class="p-1 text-statusDanger hover:bg-statusDanger/10 rounded transition btn-delete-image"
                                        data-confirm="@L["Admin_Product_Images_DeleteConfirm"].Value">
                                    <i class="ph-bold ph-trash text-sm"></i>
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Modal xác nhận xóa ảnh -->
<div id="deleteImageModal" class="fixed inset-0 z-50 bg-charcoal/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-surface rounded-card border border-borderLight p-6 max-w-md w-full shadow-hover space-y-4">
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-statusDanger/15 text-statusDanger flex items-center justify-center shrink-0">
                <i class="ph-bold ph-trash text-xl"></i>
            </div>
            <div>
                <h3 class="font-bold text-charcoal text-base">@L["Admin_Confirm_Title"]</h3>
                <p id="deleteModalMessage" class="text-xs text-muted mt-1 leading-relaxed"></p>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2.5 pt-2">
            <button type="button" id="btnDeleteCancel" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                @L["Common_Cancel"]
            </button>
            <button type="button" id="btnDeleteConfirm" class="px-4 py-2 bg-statusDanger hover:bg-statusDanger/90 text-white text-xs font-bold rounded-btn transition shadow-sm">
                @L["Common_Delete"]
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Khởi tạo Quill
            var quill = new Quill('#quill-editor', {
                theme: 'snow',
                placeholder: 'Nhập mô tả chi tiết sản phẩm...',
                modules: {
                    toolbar: [
                        ['bold', 'italic', 'underline'],
                        [{ 'header': 2 }, { 'header': 3 }],
                        [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                        ['blockquote', 'link'],
                        ['clean']
                    ]
                }
            });

            // Nạp nội dung đã sanitize từ rawMoTa
            var rawMoTa = document.getElementById('rawMoTa').value;
            if (rawMoTa) {
                quill.clipboard.dangerouslyPasteHTML(rawMoTa);
            }

            // Chặn dán & kéo thả ảnh
            var editorElement = document.querySelector('#quill-editor .ql-editor');
            if (editorElement) {
                editorElement.addEventListener('paste', function (e) {
                    if (e.clipboardData && e.clipboardData.files && e.clipboardData.files.length > 0) {
                        e.preventDefault();
                        alert('Không hỗ trợ dán ảnh trực tiếp vào nội dung mô tả.');
                    }
                });

                editorElement.addEventListener('drop', function (e) {
                    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
                        e.preventDefault();
                        alert('Không hỗ trợ kéo thả ảnh vào nội dung mô tả.');
                    }
                });
            }

            // Xử lý submit: thay &nbsp; bằng khoảng trắng theo Điều chỉnh 1
            var form = document.getElementById('formSuaSanPham');
            form.addEventListener('submit', function () {
                var html = quill.getSemanticHTML();
                if (html) {
                    html = html.replace(/&nbsp;/g, ' ');
                }
                if (quill.getText().trim().length === 0) {
                    html = '';
                }
                document.getElementById('MoTa').value = html;
            });

            // Modal xóa ảnh
            var modal = document.getElementById('deleteImageModal');
            var modalMsg = document.getElementById('deleteModalMessage');
            var btnCancel = document.getElementById('btnDeleteCancel');
            var btnConfirm = document.getElementById('btnDeleteConfirm');
            var currentForm = null;

            function openModal(msg, form) {
                currentForm = form;
                modalMsg.textContent = msg;
                modal.classList.remove('hidden');
            }

            function closeModal() {
                modal.classList.add('hidden');
                currentForm = null;
            }

            btnCancel.addEventListener('click', closeModal);

            btnConfirm.addEventListener('click', function () {
                if (currentForm) {
                    currentForm.submit();
                }
            });

            document.querySelectorAll('.btn-delete-image').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var msg = this.dataset.confirm || '';
                    var form = this.closest('form');
                    openModal(msg, form);
                });
            });
        });
    </script>
}
