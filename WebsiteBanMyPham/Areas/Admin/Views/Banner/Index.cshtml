@model List<WebsiteBanMyPham.ViewModels.Admin.BannerAdminListItemViewModel>
@{
    ViewData["Title"] = L["Admin_Banner_Title"].Value;
}

<div class="space-y-6">
    <!-- Thông báo TempData -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusSuccess/15 border border-statusSuccess/30 text-statusSuccess text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-check-circle text-base"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="p-4 rounded-card bg-statusDanger/15 border border-statusDanger/30 text-statusDanger text-xs font-semibold flex items-center gap-2">
            <i class="ph-fill ph-warning-circle text-base"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- Tab điều hướng phụ (Mã khuyến mãi / Banner quảng cáo) -->
    <div class="flex items-center gap-2 border-b border-borderLight pb-3">
        <a asp-area="Admin" asp-controller="KhuyenMai" asp-action="Index"
           class="px-4 py-2 text-xs font-semibold rounded-btn transition text-muted hover:text-charcoal hover:bg-surface/60 flex items-center gap-2">
            <i class="ph-bold ph-ticket text-base"></i>
            <span>@L["Admin_Tab_Promotions"]</span>
        </a>
        <a asp-area="Admin" asp-controller="Banner" asp-action="Index"
           class="px-4 py-2 text-xs font-bold rounded-btn transition bg-surface text-charcoal shadow-sm border border-borderLight flex items-center gap-2">
            <i class="ph-bold ph-image text-base text-primary"></i>
            <span>@L["Admin_Tab_Banners"]</span>
        </a>
    </div>

    <!-- Header quản lý Banner & Nút Thêm mới -->
    <div class="flex flex-wrap items-center justify-between gap-4 bg-surface p-5 rounded-card border border-borderLight shadow-soft">
        <div>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Banner_Title"]</h1>
            <p class="text-xs text-muted mt-0.5">@L["Admin_Banner_List"] (@Model.Count)</p>
        </div>
        <div>
            <a asp-area="Admin" asp-controller="Banner" asp-action="Them"
               class="px-4 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm flex items-center gap-1.5">
                <i class="ph-bold ph-plus text-sm"></i> @L["Admin_Banner_Add"]
            </a>
        </div>
    </div>

    <!-- Bảng danh sách Banner -->
    <div class="bg-surface rounded-card border border-borderLight shadow-soft overflow-hidden">
        @if (Model.Count == 0)
        {
            <div class="p-12 text-center text-muted text-xs">
                <i class="ph ph-image text-4xl block mb-2 opacity-40"></i>
                <span>@L["Admin_Banner_Empty"]</span>
            </div>
        }
        else
        {
            <div class="overflow-x-auto">
                <table class="w-full text-left text-xs divide-y divide-borderLight">
                    <thead class="bg-cream font-bold text-charcoal uppercase tracking-wider text-[11px]">
                        <tr>
                            <th class="p-3 w-20 text-center">@L["Admin_Banner_Col_Order"]</th>
                            <th class="p-3 w-36">@L["Admin_Banner_Col_Image"]</th>
                            <th class="p-3">@L["Admin_Banner_Col_Title"]</th>
                            <th class="p-3">@L["Admin_Banner_Col_Link"]</th>
                            <th class="p-3 text-center">@L["Admin_Banner_Col_Status"]</th>
                            <th class="p-3 text-right">@L["Common_Action"]</th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-borderLight">
                        @foreach (var item in Model)
                        {
                            <tr class="hover:bg-cream/40 transition">
                                <td class="p-3 text-center">
                                    <form asp-area="Admin" asp-controller="Banner" asp-action="CapNhatThuTu" asp-route-id="@item.MaBanner" method="post" class="inline-flex items-center justify-center gap-1">
                                        <input type="number" name="thuTuMoi" value="@item.ThuTu" min="0" max="999"
                                               data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Banner_Col_Order"].Value, 0)"
                                               data-msg-max="@string.Format(L["Validation_Range"].Value, L["Admin_Banner_Col_Order"].Value, 0, 999)"
                                               class="w-14 text-center font-mono font-bold text-xs p-1 rounded border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                                        <button type="submit" class="p-1 text-primary hover:bg-pastel/40 rounded transition" title="@L["Common_Save"]">
                                            <i class="ph-bold ph-check text-xs"></i>
                                        </button>
                                    </form>
                                </td>
                                <td class="p-3">
                                    <div class="w-32 h-16 rounded overflow-hidden border border-borderLight bg-cream shrink-0">
                                        <img src="@item.DuongDanAnh" alt="@(item.TieuDe ?? "Banner")"
                                             onerror="this.src='/images/placeholder.svg'"
                                             class="w-full h-full object-cover" />
                                    </div>
                                </td>
                                <td class="p-3">
                                    <div class="font-bold text-charcoal text-xs">
                                        @(string.IsNullOrWhiteSpace(item.TieuDe) ? "—" : item.TieuDe)
                                    </div>
                                </td>
                                <td class="p-3 text-muted font-mono text-[11px] max-w-xs truncate">
                                    @(string.IsNullOrWhiteSpace(item.LienKet) ? "—" : item.LienKet)
                                </td>
                                <td class="p-3 text-center whitespace-nowrap">
                                    @if (item.TrangThai)
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#E6F4EE] text-statusSuccess">
                                            @L["Admin_Filter_Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#FCEAEA] text-statusDanger">
                                            @L["Admin_Filter_Inactive"]
                                        </span>
                                    }
                                </td>
                                <td class="p-3 text-right whitespace-nowrap">
                                    <div class="flex items-center justify-end gap-1.5">
                                        <!-- Sửa -->
                                        <a asp-area="Admin" asp-controller="Banner" asp-action="Sua" asp-route-id="@item.MaBanner"
                                           class="px-2.5 py-1 text-primary hover:bg-pastel/40 rounded font-semibold transition" title="@L["Common_Edit"]">
                                            @L["Common_Edit"]
                                        </a>

                                        <!-- Bật/Tắt -->
                                        <form asp-area="Admin" asp-controller="Banner" asp-action="DatTrangThai" asp-route-id="@item.MaBanner" method="post" class="inline">
                                            <input type="hidden" name="trangThaiMoi" value="@((!item.TrangThai).ToString().ToLower())" />
                                            @if (item.TrangThai)
                                            {
                                                <button type="submit" class="px-2 py-1 text-muted hover:text-statusDanger hover:bg-[#FCEAEA] rounded text-xs transition" title="@L["Admin_Action_Deactivate"]">
                                                    <i class="ph ph-power"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="px-2 py-1 text-statusSuccess hover:bg-[#E6F4EE] rounded text-xs transition" title="@L["Admin_Action_Activate"]">
                                                    <i class="ph ph-check"></i>
                                                </button>
                                            }
                                        </form>

                                        <!-- Xóa -->
                                        <form asp-area="Admin" asp-controller="Banner" asp-action="Xoa" asp-route-id="@item.MaBanner" method="post" class="inline">
                                            <button type="button" class="btn-delete-banner px-2 py-1 text-muted hover:text-statusDanger hover:bg-[#FCEAEA] rounded text-xs transition"
                                                    data-message="@L["Admin_Banner_Delete_Confirm"].Value" title="@L["Common_Delete"]">
                                                <i class="ph ph-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<!-- Modal xác nhận xóa Banner -->
<div id="bannerDeleteModal" class="fixed inset-0 z-50 bg-charcoal/50 backdrop-blur-sm hidden flex items-center justify-center p-4">
    <div class="bg-surface rounded-card border border-borderLight p-6 max-w-md w-full shadow-hover space-y-4">
        <div class="flex items-start gap-3">
            <div class="w-10 h-10 rounded-full bg-[#FCEAEA] text-statusDanger flex items-center justify-center shrink-0">
                <i class="ph-bold ph-trash text-xl"></i>
            </div>
            <div>
                <h3 class="font-bold text-charcoal text-base">@L["Admin_Confirm_Title"]</h3>
                <p id="bannerDeleteModalMessage" class="text-xs text-muted mt-1 leading-relaxed"></p>
            </div>
        </div>
        <div class="flex items-center justify-end gap-2.5 pt-2">
            <button type="button" id="btnBannerCancel" class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                @L["Common_Cancel"]
            </button>
            <button type="button" id="btnBannerConfirm" class="px-4 py-2 bg-statusDanger hover:bg-statusDanger/90 text-white text-xs font-bold rounded-btn transition shadow-sm">
                @L["Common_Delete"]
            </button>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var modal = document.getElementById('bannerDeleteModal');
            var msgEl = document.getElementById('bannerDeleteModalMessage');
            var btnCancel = document.getElementById('btnBannerCancel');
            var btnConfirm = document.getElementById('btnBannerConfirm');
            var currentForm = null;

            document.querySelectorAll('.btn-delete-banner').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var msg = this.dataset.message || '';
                    currentForm = this.closest('form');
                    msgEl.textContent = msg;
                    modal.classList.remove('hidden');
                });
            });

            btnCancel.addEventListener('click', function () {
                modal.classList.add('hidden');
                currentForm = null;
            });

            btnConfirm.addEventListener('click', function () {
                if (currentForm) {
                    currentForm.submit();
                }
            });
        });
    </script>
}

