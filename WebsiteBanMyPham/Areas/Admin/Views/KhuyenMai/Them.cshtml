@model WebsiteBanMyPham.ViewModels.Admin.KhuyenMaiAdminFormViewModel
@{
    ViewData["Title"] = L["Admin_Promo_Add"].Value;
}

<div class="max-w-3xl mx-auto space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="flex items-center justify-between">
        <div>
            <a asp-area="Admin" asp-controller="KhuyenMai" asp-action="Index" class="text-xs text-muted hover:text-primary transition flex items-center gap-1 mb-1">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_Promo_Add"]</h1>
            <p class="text-xs text-muted">@L["Admin_Promo_Title"]</p>
        </div>
    </div>

    <!-- Form Thêm mới -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft">
        <form asp-area="Admin" asp-controller="KhuyenMai" asp-action="Them" method="post" class="space-y-5">
            <div asp-validation-summary="ModelOnly" class="p-3.5 rounded-btn bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs font-semibold"></div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Mã khuyến mãi -->
                <div>
                    <label asp-for="Code" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_Code"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="Code" maxlength="30" placeholder="VD: SALE20, TRIAN50K"
                           class="w-full text-xs font-mono font-bold uppercase p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="Code" class="text-[11px] text-statusDanger block mt-0.5"></span>
                    <span class="text-[11px] text-muted block mt-0.5">@L["Admin_Promo_CodeHint"]</span>
                </div>

                <!-- Tên khuyến mãi -->
                <div>
                    <label asp-for="TenKM" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_Name"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="TenKM" maxlength="150" placeholder="VD: Giảm 20% cho đơn hàng đầu tiên"
                           class="w-full text-xs p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="TenKM" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <!-- Loại giảm -->
                <div>
                    <label asp-for="LoaiGiam" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_Type"] <span class="text-statusDanger">*</span>
                    </label>
                    <select asp-for="LoaiGiam" id="selectLoaiGiam"
                            class="w-full text-xs p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition">
                        <option value="@WebsiteBanMyPham.Constants.LoaiGiamGiaConstant.PhanTram">@L["Admin_Promo_Type_Percent"]</option>
                        <option value="@WebsiteBanMyPham.Constants.LoaiGiamGiaConstant.SoTien">@L["Admin_Promo_Type_Amount"]</option>
                    </select>
                    <span asp-validation-for="LoaiGiam" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>

                <!-- Mức giảm -->
                <div>
                    <label asp-for="GiaTriGiam" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_Value"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="GiaTriGiam" type="number" step="1" min="1"
                           data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Promo_Col_Value"].Value, 1)"
                           class="w-full text-xs font-mono p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="GiaTriGiam" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>

                <!-- Giảm tối đa (chỉ khi % giảm) -->
                <div id="boxGiamToiDa">
                    <label asp-for="GiamToiDa" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_MaxDiscount"] (đ)
                    </label>
                    <input asp-for="GiamToiDa" type="number" step="1000" min="1000" placeholder="VD: 50000"
                           data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Promo_Col_MaxDiscount"].Value, "1.000")"
                           class="w-full text-xs font-mono p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="GiamToiDa" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Đơn tối thiểu -->
                <div>
                    <label asp-for="DonToiThieu" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_Col_MinOrder"] (đ)
                    </label>
                    <input asp-for="DonToiThieu" type="number" step="1000" min="0"
                           data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Promo_Col_MinOrder"].Value, 0)"
                           class="w-full text-xs font-mono p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="DonToiThieu" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>

                <!-- Số lượt tối đa -->
                <div>
                    <label asp-for="SoLuotToiDa" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_MaxUses"]
                    </label>
                    <input asp-for="SoLuotToiDa" type="number" step="1" min="1" placeholder="@L["Admin_Promo_Unlimited"]"
                           data-msg-min="@string.Format(L["Validation_RangeMin"].Value, L["Admin_Promo_MaxUses"].Value, 1)"
                           class="w-full text-xs font-mono p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="SoLuotToiDa" class="text-[11px] text-statusDanger block mt-0.5"></span>
                    <span class="text-[11px] text-muted block mt-0.5">@L["Admin_Promo_MaxUsesHint"]</span>
                </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <!-- Ngày bắt đầu -->
                <div>
                    <label asp-for="NgayBatDau" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_StartDate"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="NgayBatDau" type="date"
                           class="w-full text-xs p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="NgayBatDau" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>

                <!-- Ngày kết thúc -->
                <div>
                    <label asp-for="NgayKetThuc" class="block text-xs font-semibold text-charcoal mb-1">
                        @L["Admin_Promo_EndDate"] <span class="text-statusDanger">*</span>
                    </label>
                    <input asp-for="NgayKetThuc" type="date"
                           class="w-full text-xs p-2.5 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition" />
                    <span asp-validation-for="NgayKetThuc" class="text-[11px] text-statusDanger block mt-0.5"></span>
                </div>
            </div>

            <!-- Trạng thái hoạt động -->
            <div class="pt-2">
                <label class="flex items-center gap-2 cursor-pointer">
                    <input asp-for="TrangThai" type="checkbox"
                           class="w-4 h-4 rounded border-borderLight text-primary focus:ring-primary/20 accent-primary" />
                    <span class="text-xs font-semibold text-charcoal">@L["Admin_Filter_Active"]</span>
                </label>
            </div>

            <!-- Nút thao tác -->
            <div class="flex items-center justify-end gap-2.5 pt-4 border-t border-borderLight">
                <a asp-area="Admin" asp-controller="KhuyenMai" asp-action="Index"
                   class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm flex items-center gap-1.5">
                    <i class="ph-bold ph-plus text-sm"></i> @L["Admin_Promo_Add"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var selectLoai = document.getElementById('selectLoaiGiam');
            var boxGiamToiDa = document.getElementById('boxGiamToiDa');

            function updateUI() {
                if (selectLoai && boxGiamToiDa) {
                    if (selectLoai.value === '@WebsiteBanMyPham.Constants.LoaiGiamGiaConstant.PhanTram') {
                        boxGiamToiDa.classList.remove('hidden');
                    } else {
                        boxGiamToiDa.classList.add('hidden');
                    }
                }
            }

            if (selectLoai) {
                selectLoai.addEventListener('change', updateUI);
                updateUI();
            }
        });
    </script>
}

