@model WebsiteBanMyPham.ViewModels.Admin.PhuongThucThanhToanEditViewModel
@{
    ViewData["Title"] = L["Admin_PaymentMethod_Edit"].Value;
    bool isCod = Model.TenPT == WebsiteBanMyPham.Constants.PhuongThucThanhToanConstant.COD;
}

<div class="max-w-2xl mx-auto space-y-6">
    <!-- Breadcrumb & Tiêu đề -->
    <div class="flex items-center justify-between">
        <div>
            <a asp-area="Admin" asp-controller="PhuongThucThanhToan" asp-action="Index" class="text-xs text-muted hover:text-primary transition flex items-center gap-1 mb-1">
                <i class="ph ph-arrow-left"></i> @L["Common_Back"]
            </a>
            <h1 class="text-lg font-bold text-charcoal">@L["Admin_PaymentMethod_Edit"]</h1>
            <p class="text-xs text-muted">@LocalizationHelper.GetPaymentMethodLabel(Model.TenPT)</p>
        </div>
    </div>

    <!-- Khung Form Sửa -->
    <div class="bg-surface p-6 rounded-card border border-borderLight shadow-soft">
        <form asp-area="Admin" asp-controller="PhuongThucThanhToan" asp-action="Sua" asp-route-id="@Model.MaPT" method="post" class="space-y-5">
            <input type="hidden" asp-for="MaPT" />
            <input type="hidden" asp-for="TenPT" />
            <input type="hidden" asp-for="TrangThai" />

            <div asp-validation-summary="ModelOnly" class="p-3 rounded-btn bg-statusDanger/10 border border-statusDanger/30 text-statusDanger text-xs font-semibold"></div>

            <!-- Tên phương thức & Loại ưu tiên (Read-only) -->
            <div>
                <label class="block text-xs font-semibold text-charcoal mb-1">@L["Admin_PaymentMethod_Name"]</label>
                <div class="flex items-center justify-between p-3 rounded-btn bg-cream border border-borderLight">
                    <div class="flex items-center gap-2">
                        <span class="font-bold text-charcoal text-sm">@LocalizationHelper.GetPaymentMethodLabel(Model.TenPT)</span>
                        <span class="font-mono text-xs text-muted">(@Model.TenPT)</span>
                    </div>
                    <div>
                        @if (isCod)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-primary text-white">
                                @L["Admin_PaymentMethod_Required"]
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-surface border border-borderLight text-charcoal">
                                @L["Admin_PaymentMethod_Optional"]
                            </span>
                        }
                    </div>
                </div>
            </div>

            <!-- Trạng thái hoạt động (Read-only display) -->
            <div>
                <label class="block text-xs font-semibold text-charcoal mb-1">@L["Admin_PaymentMethod_Status"]</label>
                <div class="p-3 rounded-btn bg-cream border border-borderLight flex items-center justify-between">
                    <div>
                        @if (Model.TrangThai)
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#E6F4EE] text-statusSuccess">
                                @L["Admin_Filter_Active"]
                            </span>
                        }
                        else
                        {
                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-semibold bg-[#FCEAEA] text-statusDanger">
                                @L["Admin_Filter_Inactive"]
                            </span>
                        }
                    </div>
                    @if (isCod)
                    {
                        <span class="text-[11px] text-muted italic">@L["Admin_PaymentMethod_CodCannotDisable"]</span>
                    }
                </div>
            </div>

            <!-- Mô tả phương thức (Có thể sửa) -->
            <div>
                <label asp-for="MoTa" class="block text-xs font-semibold text-charcoal mb-1">@L["Admin_PaymentMethod_Desc"]</label>
                <textarea asp-for="MoTa" rows="4" maxlength="255"
                          class="w-full text-xs p-3 rounded-btn border border-borderLight bg-cream focus:bg-surface focus:outline-none focus:border-primary transition leading-relaxed"></textarea>
                <div class="flex items-center justify-between mt-1 text-[11px] text-muted">
                    <span asp-validation-for="MoTa" class="text-statusDanger"></span>
                    <span>Tối đa 255 ký tự</span>
                </div>
            </div>

            <!-- Nút thao tác -->
            <div class="flex items-center justify-end gap-2.5 pt-3 border-t border-borderLight">
                <a asp-area="Admin" asp-controller="PhuongThucThanhToan" asp-action="Index"
                   class="px-4 py-2 bg-cream hover:bg-pastel/40 text-charcoal text-xs font-semibold rounded-btn border border-borderLight transition">
                    @L["Common_Cancel"]
                </a>
                <button type="submit" class="px-5 py-2 bg-primary hover:bg-primaryHover text-white text-xs font-bold rounded-btn transition shadow-sm flex items-center gap-1.5">
                    <i class="ph-bold ph-floppy-disk text-sm"></i> @L["Common_Save"]
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

